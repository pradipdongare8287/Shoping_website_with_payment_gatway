<div class="beauty-product-card product-card">

    <span class="beauty-product-badge"><%=beauty[i].Product_Status%></span>

    <div class="beauty-product-image">
        <img
            src="/images/<%=beauty[i].Prdouct_image%>"
            alt="Skincare Serum"
        >
    </div>

    <div class="beauty-product-info">

        <span class="beauty-product-category"><%=beauty[i].product_category%></span>

        <h3><%=beauty[i].product_name%></h3>

        <div class="beauty-rating">
            ★★★★★
            <small>(<%=beauty[i].product_rating%>)</small>
        </div>

        <div class="beauty-product-price">
            ₹<span class="total-price"><%=beauty[i].product_new_price%></span>
            <del>₹<%=beauty[i].product_old_price%></del>
        </div>

        <!-- Size Selector -->
         <div class="size-box">
            <label>Select Size:</label>
            <select class="product-size">
                <option value="">Choose Size</option>
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="3XL">3XL</option>
                <option value="4XL">4XL</option>
            </select>
        </div>
        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

            <input type="number"
                class="qty-input"
                value="1"
                readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

        <button type="button"
                class="product-cart-btn buy-now"
                data-id="<%=beauty[i].pid%>"
                data-price="<%=beauty[i].product_new_price%>"
                data-url="/payment_beauyt_product/<%=beauty[i].pid%>">

            <i class="fa-solid fa-cart-shopping"></i>
            Buy Now

        </button>

    </div>

</div>

            <% } %>

        </div>

    </section>


    <!-- Beauty Promise -->
    <section class="beauty-promise">

        <div class="beauty-promise-item">
            <span>♡</span>
            <h3>Beauty For Everyone</h3>
            <p>Celebrate your own unique beauty.</p>
