<%-include('header.ejs')%>




    <!-- Products -->
    <section class="beauty-products" id="beauty-products">

        <div class="beauty-heading">
            <span>Brand Linan Product</span>
            <h2>सर्व लिनन कपडे </h2>
            <p>Find your next favorite from our Linan collection.</p>
        </div>

        <div class="beauty-product-grid">

            <!-- Product 1 -->
             <% for(var i =0;i<beauty.length;i++){ %>      
<div class="beauty-product-card product-card">

    <span class="beauty-product-badge"><%=beauty[i].Product_Status%></span>

    <div class="beauty-product-image">
        <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/beauty_products/<%=beauty[i].Prdouct_image%>" target="_blank">
            <img
                src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/beauty_products/<%=beauty[i].Prdouct_image%>"
                alt="Skincare Serum"
            >
        </a>
    </div>

    <div class="beauty-product-info">

        <span class="beauty-product-category"><%=beauty[i].product_category%></span>

        <h3><%=beauty[i].product_name%></h3>

        <div class="beauty-rating">
            ★★★★★
            <small>(<%=beauty[i].product_rating%>)</small>
        </div>

        <div class="beauty-product-price">
            ₹<span class="total-price"><%=beauty[i].product_new_price%></span>
            <del>₹<%=beauty[i].product_old_price%></del>
        </div>
         <!-- Product Colour Selector -->
            <!-- <div class="product-color-box">

                <label>Select Colour:</label>

                <div class="product-colors">

                    <% 
                        var colors = [];
                        try {
                            colors = JSON.parse(beauty[i].Product_color || '[]');
                        } catch (e) {
                            colors = [];
                        }
                    %>

                    <% colors.forEach(function(color) { %>

                        <button type="button"
                                class="color-option"
                                data-color="<%= color %>"
                                style="padding:5px 12px; margin:4px; border:1px solid #ccc; border-radius:5px; cursor:pointer;">
                            <%= color %>
                        </button>

                    <% }) %>

                </div>

                <p class="selected-color">
                    Selected Colour: <span class="color-name">None</span>
                </p>

            </div> -->

        <!-- Size Selector -->
         <div class="size-box">
            <label>Select Size:</label>

            <select class="product-size">
                <option value="">Choose Size</option>

                <% 
                    var sizes = [];
                    try {
                        sizes = JSON.parse(beauty[i].Product_size || '[]');
                    } catch (e) {
                        sizes = [];
                    }
                %>

                <% sizes.forEach(function(size) { %>
                    <option value="<%= size %>"><%= size %></option>
                <% }) %>

            </select>
        </div>
        <!-- Available Stock -->
        <div class="available-stock">

                <% if (beauty[i].Product_stock > 0) { %>

                    <span style="color: green; font-weight: bold;">
                        Available Stock: <%= beauty[i].Product_stock %>
                    </span>

                <% } else { %>

                    <span style="color: red; font-weight: bold;">
                        Product Not Available
                    </span>

                <% } %>

        </div>
        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

            <input type="number"
                class="qty-input"
                value="1"
                data-stock="<%= beauty[i].Product_stock %>"
                readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

        <% if (beauty[i].Product_stock > 0) { %>


          <!-- Cart button -->
     <button type="button"
            style="margin-bottom:7px;"
            class="product-cart-btn add-to-cart"
            data-id="<%= beauty[i].pid %>"
            data-price="<%= beauty[i].product_new_price %>"
            data-stock="<%= beauty[i].Product_stock %>"
            data-type="beauty">

        <i class="fa-solid fa-cart-plus"></i>
        Add to Cart

    </button>  

    <button type="button"
            class="product-cart-btn buy-now"
            data-price="<%=beauty[i].product_new_price%>"
            data-stock="<%= beauty[i].Product_stock %>"
            data-url="/payment_beauyt_product/<%=beauty[i].pid%>">

        <i class="fa-solid fa-cart-shopping"></i>
        Buy Now

    </button>

<% } else { %>

    <button type="button" class="product-cart-btn" disabled
            style="background: #999; cursor: not-allowed;">

        Product Not Available

    </button>

<% } %>
        

    </div>

</div>

            <% } %>

        </div>

    </section>


    <!-- Beauty Promise -->
    <section class="beauty-promise">

        <div class="beauty-promise-item">
            <span>♡</span>
            <h3>Beauty For Everyone</h3>
            <p>Celebrate your own unique beauty.</p>
        </div>

        <div class="beauty-promise-item">
            <span>✦</span>
            <h3>Discover Your Style</h3>
            <p>Find products that suit your style.</p>
        </div>

        <div class="beauty-promise-item">
            <span>❀</span>
            <h3>Everyday Self Care</h3>
            <p>Make time for yourself every day.</p>
        </div>

    </section>

</section>

<%-include('footer.ejs')%>
