<%-include('header.ejs')%>
    <!-- Navigation -->
  

    <!-- Hero Section -->
    <section class="hero">

        <div class="hero-content">

            <span class="hero-tag">
                <i class="fa-solid fa-fire"></i>
                THE BIGGEST SALE
            </span>

            <h1>
                Discover Your
                <span>Style</span>
            </h1>

            <p>
                Shop the latest trends with amazing deals.
                Quality products, unbeatable prices and
                a shopping experience you'll love.
            </p>

            <div class="hero-buttons">

                <a href="#" class="shop-btn">
                    Shop Now
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="#" class="explore-btn">
                    Explore Collection
                </a>

            </div>

            <div class="hero-stats">

                <div>
                    <h3>10K+</h3>
                    <p>Happy Customers</p>
                </div>

                <div>
                    <h3>50000+</h3>
                    <p>Products</p>
                </div>

                <div>
                    <h3>4.9★</h3>
                    <p>Customer Rating</p>
                </div>

            </div>

        </div>

        <div class="hero-image">

            <div class="image-circle"></div>

            <img src="https://images.meesho.com/images/products/195367362/hls9d_512.avif?width=360"
                alt="Stylish Shopping Product">

            <div class="discount-card">
                <span>Cheks</span>
                <h2>Lining</h2>
                <p>Linan</p>
            </div>

            <div class="floating-card">
                <i class="fa-sharp fa-solid fa-cart-shopping"></i>
                <div>
                    <h4>Easy To Shop</h4>
                    <p>Any Time Shopping</p>
                </div>
            </div>

        </div>

    </section>

    <!-- Categories -->
    <section class="categories section">

        <div class="section-heading">
            <div>
                <span class="small-title">SHOP BY CATEGORY</span>
                <h2>Explore Categories</h2>
            </div>

            <a href="#">View All <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="category-grid">

        <%  categrory_product.forEach((category,index)=>{ %>
            
            <a class="category-card">
                <div class="category-image">
                    <img src="/images/<%=category.Product_image%>"
                        alt="Fashion">
                </div>
                <h3><%=category.Product_category%></h3>
                <p><%=category.Product_name%></p>
            </a>
        
            

        <% }) %>
        
            </div>
    </section>

    <!-- Trending Products -->
    <section class="products section">

        <div class="section-heading">
            <div>
                <span class="small-title">OUR COLLECTION</span>
                <h2>Trending Products</h2>
            </div>

            <a href="#">View All <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="product-grid">

            <!-- Product 1 -->
             <% for(var i=0;i<product.length;i++){ %>
            
                   
<div class="product-card">

    <div class="product-image">
        <span class="sale-badge">
            <%= product[i].TProduct_discount %> % OFF
        </span>

        <button class="wishlist">
            <i class="fa-regular fa-heart"></i>
        </button>

        <img src="/images/<%= product[i].TProduct_image %>"
            alt="Product">
    </div>

    <div class="product-info">

        <span class="product-category">
            <%= product[i].TProduct_category %>
        </span>

        <h3><%= product[i].TProduct_name %></h3>

        <div class="rating">
            <% for (var a = 0; a < product[i].TProduct_rating; a++) { %>
                ★
            <% } %>
            <span>(<%= product[i].TProduct_rating %>)</span>
        </div>

        <div class="price">
            <strong>
                ₹<span class="total-price"><%= product[i].TProduct_new_price %></span>
            </strong>
            <del>₹<%= product[i].TProduct_old_price %></del>
        </div>

        <!-- Size Selector -->
        <div class="size-box">
            <label>Select Size:</label>

            <select class="product-size">
                <option value="">Choose Size</option>
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="3XL">3XL</option>
                <option value="4XL">4XL</option>
            </select>
        </div>

        <!-- Quantity Selector -->
        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

            <input type="number"
                class="qty-input"
                value="1"
                min="1"
                readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

        <!-- Buy Now -->
        <button type="button"
            class="product-cart-btn buy-now"
            data-price="<%= product[i].TProduct_new_price %>"
            data-url="/trending_product_payemnt/<%= product[i].tpid %>">

            <i class="fa-solid fa-cart-shopping"></i>
            Buy Now

        </button>

    </div>

</div>


                <% } %>
            

         

        </div>

    </section>

    <!-- Promotional Banner -->
    <section class="promo-banner">

        <div class="promo-content">

            <span>LIMITED TIME OFFER</span>

            <h2>Upgrade Your Style.<br>Upgrade Your Life.</h2>

            <p>Discover amazing products at unbeatable prices.</p>

            <a href="#" class="shop-btn">
                Shop Collection
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

        <div class="promo-icon">
            <i class="fa-solid fa-gift"></i>
        </div>

    </section>

    <!-- Benefits -->
    <section class="benefits section">

        <div class="benefit-card">
            <i class="fa-sharp fa-solid fa-cart-shopping"></i>
            <h3>Any Time Shipping</h3>
            <p>Shop Any Time</p>
        </div>

        <div class="benefit-card">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Secure Payment</h3>
            <p>100% safe and secure payments</p>
        </div>

        <div class="benefit-card">
            <i class="fa-solid fa-magnifying-glass"></i>
            <h3>Track Order</h3>
            <p>Easy To Tracking Order</p>
        </div>

        <div class="benefit-card">
            <i class="fa-solid fa-headset"></i>
            <h3>24/7 Support</h3>
            <p>We are always here to help you</p>
        </div>

    </section>

    <!-- Footer -->
<%-include('footer.ejs') %>

</body>

</html>
