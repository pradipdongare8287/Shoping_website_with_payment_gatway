            </div>
    </section>

    <!-- Trending Products -->
    <section class="products section">

        <div class="section-heading">
            <div>
                <span class="small-title">OUR COLLECTION</span>
                <h2>Trending Products</h2>
            </div>

            <a href="#">View All <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="product-grid">

            <!-- Product 1 -->
             <% for(var i=0;i<product.length;i++){ %>
            
                   
<div class="product-card">

    <div class="product-image">
        <span class="sale-badge">
            <%= product[i].TProduct_discount %> % OFF
        </span>

        <button class="wishlist">
            <i class="fa-regular fa-heart"></i>
        </button>

        <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/trending_products/<%= product[i].TProduct_image %>" target="_blank">
            <img src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/trending_products/<%= product[i].TProduct_image %>"
            alt="Product">
        </a>
    </div>

    <div class="product-info">

        <span class="product-category">
            <%= product[i].TProduct_category %>
        </span>

        <h3><%= product[i].TProduct_name %></h3>

        <div class="rating">
            <% for (var a = 0; a < product[i].TProduct_rating; a++) { %>
                ★
            <% } %>
            <span>(<%= product[i].TProduct_rating %>)</span>
        </div>

        <div class="price">
            <strong>
                ₹<span class="total-price"><%= product[i].TProduct_new_price %></span>
            </strong>
            <del>₹<%= product[i].TProduct_old_price %></del>
        </div>

        <!-- Size Selector -->
        <div class="size-box">
            <label>Select Size:</label>

            <select class="product-size">
                <option value="">Choose Size</option>
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="3XL">3XL</option>
                <option value="4XL">4XL</option>
            </select>
        </div>

        <!-- Available Stock -->
            <div class="available-stock">

                <% if (product[i].Product_stock > 0) { %>

                    <span style="color: green; font-weight: bold;">
                        Available Stock: <%= product[i].Product_stock %>
                    </span>

                <% } else { %>

                    <span style="color: red; font-weight: bold;">
                        Product Not Available
                    </span>

                <% } %>

            </div>
            
        <!-- Quantity Selector -->
        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

                    <input type="number"
            class="qty-input"
            value="1"
            min="1"
            data-stock="<%= product[i].Product_stock %>"
            readonly>

            <button type="button" class="qty-plus">+</button>

        </div>
        

          <!-- Buy Now -->
<% if (product[i].Product_stock > 0) { %>

    <button type="button"
            class="product-cart-btn buy-now"
            data-price="<%= product[i].TProduct_new_price %>"
            data-stock="<%= product[i].Product_stock %>"
            data-url="/trending_product_payemnt/<%= product[i].tpid %>">

        <i class="fa-solid fa-cart-shopping"></i>
        Buy Now

    </button>

<% } else { %>

    <button type="button" class="product-cart-btn" disabled
            style="background: #999; cursor: not-allowed;">

        Product Not Available

    </button>

<% } %>

    </div>

</div>


                <% } %>
            

         

        </div>

    </section>

    <!-- Promotional Banner -->
    

    <!-- Benefits -->
    <section class="benefits section">

        <div class="benefit-card">
            <i class="fa-sharp fa-solid fa-cart-shopping"></i>
            <h3>Any Time Shipping</h3>
            <p>Shop Any Time</p>
        </div>

        <div class="benefit-card">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Secure Payment</h3>
            <p>100% safe and secure payments</p>
        </div>

        <div class="benefit-card">
            <i class="fa-solid fa-magnifying-glass"></i>
            <h3>Track Order</h3>
            <p>Easy To Tracking Order</p>
        </div>

        <div class="benefit-card">
            <i class="fa-solid fa-headset"></i>
            <h3>24/7 Support</h3>
            <p>We are always here to help you</p>
        </div>

    </section>

    <!-- Footer -->
<%-include('footer.ejs') %>

</body>

</html>
