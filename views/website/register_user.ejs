
<!DOCTYPE html>
<html>
<head>
    <title>User Registration Form</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="website/register.css">
</head>

<body>

    <div class="registration-container">

        <h2>User Registration</h2>

        <form action="/save_user" onsubmit="return confirm('Are You Sure Register Your Account')" method="POST">

            <!-- User Name -->
            <label>User Name</label>
            <input type="text"
                   name="user_name"
                   placeholder="Enter your name"
                   required>

            <!-- User Email -->
            <label>User Email</label>
            <input type="email"
                   name="user_email"
                   placeholder="Enter your email"
                   required>

            <% if(warning=='Please Enter Other Email This Email Is Used'){ %>
                <span class="warning-message"><%=warning%></span>
            <% } else{ %>

            <% } %>
            <br/><br/>

            <!-- User Password -->
            <label>User Password</label>
            <input type="password"
                   name="user_password"
                   placeholder="Enter your password"
                   required
                   minlength="8">

            <!-- User Mobile -->
            <label>User Mobile</label>
            <input type="tel"
                   name="user_mobile"
                   placeholder="Enter mobile number"
                   pattern="[0-9]{10}"
                   maxlength="10"
                   required>

            <!-- User Address -->
            <label>User Address</label>
            <textarea name="user_address"
                      placeholder="Enter your address"
                      rows="3"
                      required></textarea>

            <!-- User Account Status -->
            <label>User Account Status</label>
            <select name="user_account_status" required>

                <option value="">Select Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>

            </select>

            <!-- Submit Button -->
            <button type="submit" class="register-btn">
                Register Now
            </button>

            <!-- Reset Button -->
            <button type="reset" class="reset-btn">
                Reset
            </button>

        </form>
    </div>

</body>
</html>
