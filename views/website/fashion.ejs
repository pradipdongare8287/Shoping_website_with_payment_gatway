<%-include('header.ejs')%>




    <!-- Fashion Hero -->

    <section class="fashion-hero">

        <div class="fashion-hero-content">

            <div class="fashion-label">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                NEW FASHION COLLECTION
            </div>

            <h1>
                Wear Your
                <span>Confidence.</span>
                Own Your Style.
            </h1>

            <p>
                Discover the latest fashion trends.
                Make every outfit a statement and
                express your unique personality.
            </p>

            <div class="fashion-hero-buttons">

                <a href="#fashion-products" class="fashion-shop-btn">
                    Shop Collection
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="#fashion-categories" class="fashion-explore-btn">
                    Explore Fashion
                </a>

            </div>

            <div class="fashion-hero-stats">

                <div>
                    <h3>500+</h3>
                    <span>Fashion Products</span>
                </div>

                <div>
                    <h3>30%</h3>
                    <span>Special Discount</span>
                </div>

            </div>

        </div>


        <!-- Hero Images -->

        <div class="fashion-hero-images">

            <div class="fashion-image-bg"></div>

            <div class="fashion-image-main">

                <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=85"
                    alt="Fashion Collection">

            </div>

            <div class="fashion-image-small">

                <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=600&q=85"
                    alt="Modern Fashion">

            </div>

            <div class="fashion-floating-discount">

                <span>UP TO</span>
                <h2>50%</h2>
                <p>OFF</p>

            </div>

            <div class="fashion-floating-text">

                <i class="fa-solid fa-shirt"></i>

                <div>
                    <h4>New Arrivals</h4>
                    <p>Fresh styles every week</p>
                </div>

            </div>

        </div>

    </section>


    <!-- Fashion Categories -->

    <section class="fashion-categories" id="fashion-categories">

        <div class="fashion-section-heading">

            <div>
                <span>EXPLORE YOUR STYLE</span>
                <h2>Shop By Category</h2>
            </div>

            <p>Find your perfect look.</p>

        </div>


        <div class="fashion-category-grid">

            <!-- Men -->

            <a href="#fashion-products" class="fashion-category-card">

                <img src="https://images.unsplash.com/photo-1516257984-b1b4d707412e?auto=format&fit=crop&w=700&q=85"
                    alt="Men Fashion">

                <div class="fashion-category-overlay">

                    <span>EXPLORE COLLECTION</span>

                    <h2>Men's Fashion</h2>

                    <div class="fashion-category-link">
                        Shop Now
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>

            </a>


            <!-- Women -->

            <a href="#fashion-products" class="fashion-category-card">

                <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=700&q=85"
                    alt="Women Fashion">

                <div class="fashion-category-overlay">

                    <span>EXPLORE COLLECTION</span>

                    <h2>Women's Fashion</h2>

                    <div class="fashion-category-link">
                        Shop Now
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>

            </a>


            <!-- Kids -->

            <a href="#fashion-products" class="fashion-category-card">

                <img src="https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=85"
                    alt="Kids Fashion">

                <div class="fashion-category-overlay">

                    <span>EXPLORE COLLECTION</span>

                    <h2>Kids Fashion</h2>

                    <div class="fashion-category-link">
                        Shop Now
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>

            </a>

        </div>

    </section>


    <!-- Fashion Promotion -->

    <section class="fashion-promo">

        <div class="fashion-promo-content">

            <span>LIMITED TIME FASHION SALE</span>

            <h2>
                Your Style.
                <br>
                Your Rules.
            </h2>

            <p>
                Refresh your wardrobe with stylish outfits
                at amazing prices.
            </p>

            <a href="#fashion-products" class="fashion-promo-btn">
                Grab The Deal
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

        <div class="fashion-promo-image">

            <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=800&q=85"
                alt="Fashion Sale">

            <div class="fashion-promo-circle">
                <span>SALE</span>
                <h2>50%</h2>
                <span>OFF</span>
            </div>

        </div>

    </section>


    <!-- Trending Fashion Products -->

    <section class="fashion-products" id="fashion-products">

        <div class="fashion-section-heading">

            <div>
                <span>THE LATEST TRENDS</span>
                <h2>Trending Fashion</h2>
            </div>

            <a href="/products">
                View All Products
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <div class="fashion-product-grid">


            <!-- Product 1 -->

            <%for(var i=0;i<fashion.length;i++){%>

            <div class="fashion-product-card">

                <div class="fashion-product-image">

                    <span class="fashion-product-badge"><%=fashion[i].fashion_product_status%></span>

                    <button class="fashion-wishlist">
                        <i class="fa-regular fa-heart"></i>
                    </button>

                    <img src="/images/<%=fashion[i].fashion_product_img%>"
                        alt="Casual Outfit">

                    <div class="fashion-quick-view">
                        <button>
                            <i class="fa-solid fa-eye"></i>
                            Quick View
                        </button>
                    </div>

                </div>

                <div class="fashion-product-info">

                    <span><%=fashion[i].fashion_product_category%> Wear</span>

                    <h3><%=fashion[i].fashion_product_name%></h3>

                    <div class="fashion-rating">
                        <%for(var a=0 ;a<fashion[i].fashion_product_rating;a++){%>
                            ★
                        <% } %>
                        
                        <small>(<%=fashion[i].fashion_product_rating%>)</small>
                    </div>

                    <div class="fashion-price">
                        <strong>₹<%=fashion[i].fashion_product_new_price%></strong>
                        <del>₹<%=fashion[i].fashion_product_old_price%></del>
                    </div>

                    <a href="/fashion_product_paymnet/<%=fashion[i].fid%>">
                        <button class="fashion-add-cart">
                        <i class="fa-solid fa-cart-shopping"></i>
                        Buy Now
                    </button>
                    </a>

                </div>

            </div>

            <% } %>
          

        </div>

    </section>


    <!-- Fashion Newsletter -->

    <section class="fashion-newsletter">

        <div class="fashion-newsletter-icon">
            <i class="fa-solid fa-envelope-open-text"></i>
        </div>

        <h2>Stay Ahead Of Fashion</h2>

        <p>
            Subscribe to get the latest fashion trends,
            exclusive offers and new arrivals.
        </p>

        <form class="fashion-newsletter-form">

            <input type="email" placeholder="Enter your email address">

            <button type="button">
                Subscribe
                <i class="fa-solid fa-arrow-right"></i>
            </button>

        </form>

    </section>



<%-include('footer.ejs')%>
