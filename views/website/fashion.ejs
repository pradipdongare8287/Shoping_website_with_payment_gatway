             <div class="all-product-card product-card">

    <div class="all-product-image">

        <span class="product-label">
            <%=fashion[i].fashion_product_status%>
        </span>

        <button class="product-wishlist">
            <i class="fa-regular fa-heart"></i>
        </button>

        <img src="/images/<%=fashion[i].fashion_product_img%>"
                        alt="Casual Outfit">


        <div class="product-overlay">
            <a href="/images/<%=fashion[i].fashion_product_img%>" target="_blank">
                <button>
                    <i class="fa-solid fa-eye"></i>
                    Quick View
                </button>
            </a>
        </div>

    </div>

    <div class="all-product-details">

        <span class="product-category">
            <%=fashion[i].fashion_product_category%> Wear
        </span>

        <h3><%=fashion[i].fashion_product_name%></h3>

        <div class="fashion-rating">
            <%for(var a=0 ;a<fashion[i].fashion_product_rating;a++){%>
                        ★
            <% } %>
                        
            <small>(<%=fashion[i].fashion_product_rating%>)</small>
        </div>

        <!-- Product Price -->
        <div class="product-price">
            <strong>
                ₹<span class="total-price">
                    ₹<%=fashion[i].fashion_product_new_price%>
                </span>
            </strong>

            <del>₹<%=fashion[i].fashion_product_old_price%></del>
        </div>
        <!-- Size Selector -->
        <div class="size-box">
            <label>Select Size:</label>

            <select class="product-size">
                <option value="">Choose Size</option>
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="3XL">3XL</option>
                <option value="4XL">4XL</option>
            </select>
        </div>

        <!-- Quantity -->
        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

            <input type="number"
                   class="qty-input"
                   value="1"
                   readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

        <!-- Buy Now -->
        
        <button type="button"
                class="product-cart-btn buy-now"
                data-price="<%= fashion[i].fashion_product_new_price %>"
            data-url="/fashion_product_paymnet/<%=fashion[i].fid%>">
            <i class="fa-solid fa-cart-shopping"></i>
            Buy Now 
        </button>

    </div>

</div>

