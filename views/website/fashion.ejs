<%-include('header.ejs')%>




    <!-- Fashion Hero -->



    <!-- Fashion Promotion -->

    


    <!-- Trending Fashion Products -->

    <section class="fashion-products" id="fashion-products">

        <div class="fashion-section-heading">

            <div>
                <span>THE LATEST TRENDS</span>
                <h2>All Type Shirts</h2>
            </div>

            <!-- <a href="/products">
                View All Products
                <i class="fa-solid fa-arrow-right"></i>
            </a> -->

        </div>


        <div class="fashion-product-grid">


            <!-- Product 1 -->

            <%for(var i=0;i<fashion.length;i++){%>

             <div class="all-product-card product-card">

    <div class="all-product-image">

        <span class="product-label">
            <%=fashion[i].fashion_product_status%>
        </span>

        <button class="product-wishlist">
            <i class="fa-regular fa-heart"></i>
        </button>

        <img src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/fashion_products/<%=fashion[i].fashion_product_img%>"
                        alt="Casual Outfit">


        <div class="product-overlay">
            <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/fashion_products/<%=fashion[i].fashion_product_img%>" target="_blank">
                <button>
                    <i class="fa-solid fa-eye"></i>
                    Quick View
                </button>
            </a>
        </div>

    </div>

    <div class="all-product-details">

        <span class="product-category">
            <%=fashion[i].fashion_product_category%> Wear
        </span>

        <h3><%=fashion[i].fashion_product_name%></h3>

        <div class="fashion-rating">
            <%for(var a=0 ;a<fashion[i].fashion_product_rating;a++){%>
                        ★
            <% } %>
                        
            <small>(<%=fashion[i].fashion_product_rating%>)</small>
        </div>

         <!-- Product Colour Selector -->
            <div class="product-color-box">

                <label>Select Colour:</label>

                <div class="product-colors">

                    <% 
                        var colors = [];
                        try {
                            colors = JSON.parse(fashion[i].Product_color || '[]');
                        } catch (e) {
                            colors = [];
                        }
                    %>

                    <% colors.forEach(function(color) { %>

                        <button type="button"
                                class="color-option"
                                data-color="<%= color %>"
                                style="padding:5px 12px; margin:4px; border:1px solid #ccc; border-radius:5px; cursor:pointer;">
                            <%= color %>
                        </button>

                    <% }) %>

                </div>

                <p class="selected-color">
                    Selected Colour: <span class="color-name">None</span>
                </p>

            </div>

        <!-- Product Price -->
        <div class="product-price">
            <strong>
                <span class="total-price">
                    ₹<%=fashion[i].fashion_product_new_price%>
                </span>
            </strong>

            <del>₹<%=fashion[i].fashion_product_old_price%></del>
        </div>
        <!-- Size Selector -->
        <div class="size-box">
            <label>Select Size:</label>

            <select class="product-size">
                <option value="">Choose Size</option>

                <% 
                    var sizes = [];
                    try {
                        sizes = JSON.parse(fashion[i].Product_size || '[]');
                    } catch (e) {
                        sizes = [];
                    }
                %>

                <% sizes.forEach(function(size) { %>
                    <option value="<%= size %>"><%= size %></option>
                <% }) %>

            </select>
        </div>
        
        <div class="available-stock">

                <% if (fashion[i].Product_stock > 0) { %>

                    <span style="color: green; font-weight: bold;">
                        Available Stock: <%= fashion[i].Product_stock %>
                    </span>

                <% } else { %>

                    <span style="color: red; font-weight: bold;">
                        Product Not Available
                    </span>

                <% } %>

            </div>
          
        <!-- Quantity -->
        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

            <input type="number"
                   class="qty-input"
                   value="1"
                   data-stock="<%= fashion[i].Product_stock %>"
                   readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

        <!-- Buy Now -->
<% if (fashion[i].Product_stock > 0) { %>

    <button type="button"
            class="product-cart-btn buy-now"
            data-price="<%= fashion[i].fashion_product_new_price %>"
            data-stock="<%= fashion[i].Product_stock %>"
            data-url="/fashion_product_paymnet/<%=fashion[i].fid%>">

        <i class="fa-solid fa-cart-shopping"></i>
        Buy Now

    </button>

<% } else { %>

    <button type="button" class="product-cart-btn" disabled
            style="background: #999; cursor: not-allowed;">

        Product Not Available

    </button>

<% } %>

     


    </div>

                </div>

            <% } %>
          

        </div>

    </section>





<%-include('footer.ejs')%>
