
<%-include('header.ejs')%>

<!-- All Products Section -->

<section class="all-products">

    <!-- Page Heading -->
    <div class="products-heading">

        <div>
            <span class="products-subtitle">OUR COLLECTION</span>
            <h1>All Products</h1>
            <p>Discover amazing products at unbeatable prices.</p>
        </div>

        <div class="products-count">
            <i class="fa-solid fa-bag-shopping"></i>
            <span>Explore Our Collection</span>
        </div>

    </div>


 


    <!-- Products Grid -->
    <div class="all-products-grid">


        
        <!-- Product 1 -->
     
            
<% for (var i = 0; i < product.length; i++) { %>

<div class="all-product-card product-card">

    <div class="all-product-image">

        <span class="product-label">
            <%= product[i].Product_status %>
        </span>

        <button class="product-wishlist">
            <i class="fa-regular fa-heart"></i>
        </button>

        <img src="/images/<%= product[i].Product_img %>"
             alt="Sport Shoes">

        <div class="product-overlay">
            <a href="/images/<%= product[i].Product_img %>" target="_self">
                <button>
                    <i class="fa-solid fa-eye"></i>
                    Quick View
                </button>
            </a>
        </div>

    </div>

    <div class="all-product-details">

        <span class="product-category">
            <%= product[i].Product_category %>
        </span>

        <h3><%= product[i].Product_name %></h3>

        <div class="product-rating">
            <% for (var a = 0; a < product[i].Product_rating; a++) { %>
                <span>★</span>
            <% } %>
            <small><%= product[i].Product_rating %></small>
        </div>

        <!-- Product Price -->
        <div class="product-price">
            <strong>
                ₹<span class="total-price">
                    <%= product[i].Product_New_price %>
                </span>
            </strong>

            <del>₹<%= product[i].Product_Old_price %></del>
        </div>

        <!-- Size Selector -->
        <div class="size-box">
            <label>Select Size:</label>

            <select class="product-size">
                <option value="">Choose Size</option>
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="3XL">3XL</option>
                <option value="4XL">4XL</option>
            </select>
        </div>

        <!-- Quantity -->
        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

            <input type="number"
                   class="qty-input"
                   value="1"
                   readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

        <!-- Buy Now -->
        <button type="button"
                class="product-cart-btn buy-now"
                data-price="<%= product[i].Product_New_price %>"
            data-url="/all_product_payment/<%= product[i].Pid %>">
            <i class="fa-solid fa-cart-shopping"></i>
            Buy Now 
        </button>

        
    </div>
    <!-- class="product-cart-btn buy-now" -->

</div>

<% } %>

            

    </div>

</section>

<%-include('footer.ejs')%>
