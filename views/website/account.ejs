<%- include('header.ejs') %>

<link rel="stylesheet" href="/website/account.css">

<section class="account-page">

    <!-- Hero Section -->
    <div class="account-hero">
        <div>
            <span class="account-tag">MY ACCOUNT</span>
            <h1>Welcome Back! <%=user.user_name%></h1>
            <p>Manage your profile, orders and account details.</p>
        </div>

        <div class="account-hero-icon">
            <i class="fa-solid fa-user"></i>
        </div>
    </div>

    <!-- Account Content -->
    <div class="account-container">

        <!-- Sidebar -->
        <div class="account-sidebar">

            <div class="profile-box">
                <!-- <div class="profile-avatar">
                    <i class="fa-solid fa-user"></i>
                </div> -->
                <div class="profile-avatar">
                        <%= user.user_name.charAt(0).toUpperCase() %>
                </div>
                <h3><%=user.user_name%></h3>
                <p><%=user.user_email%></p>
            </div>

            <a href="/account" class="account-menu active">
                <i class="fa-solid fa-user"></i>
                My Profile
            </a>

            <!-- <a href="/my-orders" class="account-menu">
                <i class="fa-solid fa-box"></i>
                My Orders
            </a> -->

            <!-- <a href="/wishlist" class="account-menu">
                <i class="fa-solid fa-heart"></i>
                My Wishlist
            </a> -->

            <!-- <a href="/address" class="account-menu">
                <i class="fa-solid fa-location-dot"></i>
                Saved Address
            </a> -->

            <a href="/logout" class="account-menu logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                Logout
            </a>

        </div>

        <!-- Main Content -->
        <div class="account-main">

            <div class="account-heading">
                <h2>Account Overview</h2>
                <p>View and manage your personal information.</p>
            </div>

            <!-- Statistics -->
            <div class="account-stats">

                <div class="stat-card">
                    <div class="stat-icon purple">
                        <i class="fa-solid fa-box"></i>
                    </div>
                    <div>
                        <h3><%=all_orders.Total_Orders%></h3>
                        <p>Total Orders</p>
                    </div>
                </div>

                <!-- <div class="stat-card">
                    <div class="stat-icon pink">
                        <i class="fa-solid fa-heart"></i>
                    </div>
                    <div>
                        <h3>08</h3>
                        <p>Wishlist Items</p>
                    </div>
                </div> -->

                <!-- <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <h3>02</h3>
                        <p>Saved Address</p>
                    </div>
                </div> -->

            </div>

            <!-- Personal Information -->
            <div class="account-card">

                <div class="card-heading">
                    <div>
                        <h3>Personal Information</h3>
                        <p>Your personal details</p>
                    </div>

                    <!-- <a href="/edit_profile" class="edit-btn">
                        <i class="fa-solid fa-pen"></i>
                        Edit Profile
                    </a> -->
                </div>

                <div class="profile-details">

                    <div class="detail-item">
                        <label>Full Name</label>
                        <h4><%=user.user_name%></h4>
                    </div>

                    <div class="detail-item">
                        <label>Email Address</label>
                        <h4><%=user.user_email%></h4>
                    </div>

                    <div class="detail-item">
                        <label>Delivary Address</label>
                        <h4><%=user.user_address%></h4>
                    </div>

                    <div class="detail-item">
                        <label>Phone Number</label>
                        <h4><%=user.user_mobile%></h4>
                    </div>

                    <div class="detail-item">
                        <label>Account Status</label>
                        <span class="status-active"><%=user.user_account_status%></span>
                    </div>

                </div>

            </div>

            <!-- Recent Orders -->
            <div class="account-card">

                <div class="card-heading">
                    <div>
                        <h3>Recent Orders</h3>
                        <p>Your latest shopping activity</p>
                    </div>

                    <!-- <a href="/my-orders" class="view-all">
                        View All <i class="fa-solid fa-arrow-right"></i>
                    </a> -->
                </div>

                <h2>My Orders</h2>
                <h3>Single Orders</h3>

<% if (orders.length > 0) { %>

    <% orders.forEach(function(order) { %>

        <div style="border:1px solid #ddd; padding:15px; margin:15px 0;">

            <h3><%= order.Product_name %></h3>

            <p>Price: ₹<%= order.Product_price %></p>
            <p>Product Size: <%= order.Product_size %></p>
            


            <p><strong>Quantity: <%= order.Product_qty %></strong></p>
            <p><strong>Color: <%= order.Product_color %></strong></p>


            <p>
                <!-- Order Date:
                <%= new Date(String(order.Order_date).replace(' ', 'T')).toLocaleString('en-IN', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: true,
                    timeZone: 'Asia/Kolkata'
                }) %> -->
                 <%
    var orderDate = String(order.Order_date);
    var parts = orderDate.split(/[- :T]/);

    var year = parts[0];
    var month = parts[1];
    var day = parts[2];

    var hour = Number(parts[3]);
    var minute = parts[4];
    var second = parts[5];

    var ampm = hour >= 12 ? 'PM' : 'AM';

    var displayHour = hour % 12 || 12;

    var formattedDate =
        day + '/' + month + '/' + year + ' ' +
        String(displayHour).padStart(2, '0') + ':' +
        minute + ':' + second + ' ' + ampm;
%>

<p>
    Order Date: <%= formattedDate %>
</p>
            </p>
            
                    

            <p>Order Status: <%= order.Order_status %></p>

            <p>Payment Status: <%= order.Payment_status %></p>
            <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/<%= order.Product_folder %>/<%= order.Product_image %>" target="_blank">

                <img
                    style="height:120px;width:130px;object-fit:contain;"
                    src="https://res.cloudinary.com/sdz5u7v8/image/upload/<%= order.Product_folder %>/<%= order.Product_image %>"
                    alt="<%= order.Product_name %>"
                >

            </a>

            <p style="margin:15px;">Order Status: <% if(order.Order_status=='Booked'){ %>
                    <span style="background-color:rgba(255, 165, 0,0.6);padding:6px;border-radius:30px;font-size:13px;color:orangered;">
                       <%= order.Order_status %>
                    </span>
                <% } else if(order.Order_status=='Placed') { %>
                    <span style="background-color:rgba(30, 255, 0, 0.6);padding:6px;border-radius:30px;font-size:13px;color:green;">
                       <%= order.Order_status %>
                    </span>
                    <% } else if(order.Order_status=='Confirm') { %>
                        <span style="background-color:rgba(196, 248, 8, 0.6);padding:6px;border-radius:30px;font-size:13px;color:rgb(18, 184, 12);">
                       <%= order.Order_status %>
                        </span>
                        <% } else if(order.Order_status=='Order Dispatched'){ %>
                        <span style="background-color:rgba(230, 75, 14, 0.6);padding:6px;border-radius:30px;font-size:13px;color:rgb(199, 85, 9);">
                            <%= order.Order_status %>
                        </span>
                        <% } %>
            </p>

            
        </div>
        <!-- Cart Orders Section -->


    <% }); %>

<% } else { %>

    <p>No orders found.</p>

<% } %>
       <div class="account-card">

    <div class="card-heading">
        <div>
            <h3>Cart Orders</h3>
            <p>Your orders placed through shopping cart</p>
        </div>
    </div>

    <% if (cart_orders.length > 0) { %>

        <%
            var grouped_orders = {};

            cart_orders.forEach(function(order) {

                if (!grouped_orders[order.Order_Group_ID]) {
                    grouped_orders[order.Order_Group_ID] = [];
                }

                grouped_orders[order.Order_Group_ID].push(order);

            });
        %>

        <% Object.values(grouped_orders).forEach(function(items) {

            var first_order = items[0];
            var grand_total = 0;

            items.forEach(function(item) {
                grand_total += Number(item.Product_price) * Number(item.Product_qty);
            });

        %>

            <div style="border:1px solid #ddd; padding:15px; margin:15px 0; border-radius:8px;">

                <h3>Order ID: <%= first_order.Order_Group_ID %></h3>

                <p>Order Date: <%= first_order.Order_date %></p>

                <p>
                    Order Status:
                    <strong><%= first_order.Order_status %></strong>
                </p>

                <p>
                    Payment Status:
                    <strong><%= first_order.Payment_status %></strong>
                </p>

                <hr>

                <% items.forEach(function(order) {

                    var folder = {
                        all_product: 'products',
                        trending: 'trending_products',
                        fashion: 'fashion_products',
                        electronics: 'electronics_products',
                        beauty: 'beauty_products'
                    };

                    var image_folder = folder[order.Product_type];

                %>

                    <div style="display:flex; align-items:center; gap:15px; padding:12px 0; border-bottom:1px solid #eee;">

                        <img
                            src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/<%= image_folder %>/<%= order.Product_image %>"
                            style="height:100px; width:110px; object-fit:contain;"
                            alt="<%= order.Product_name %>"
                        >

                        <div>

                            <h4><%= order.Product_name %></h4>

                            <p>Price: ₹<%= order.Product_price %></p>

                            <p>Quantity: <%= order.Product_qty %></p>

                            <p>Size: <%= order.Product_size %></p>

                            <p>
                                Product Total:
                                ₹<%= (Number(order.Product_price) * Number(order.Product_qty)).toFixed(2) %>
                            </p>

                        </div>

                    </div>

                <% }); %>

                <h3 style="text-align:right; margin-top:15px;">
                    Grand Total: ₹<%= grand_total.toFixed(2) %>
                </h3>

            </div>

        <% }); %>

    <% } else { %>

        <p>No Cart Orders found.</p>

    <% } %>

</div>

            </div>

        </div>

    </div>

</section>

<%- include('footer.ejs') %>