<div class="product-card">

    <span class="product-badge"><%=all_products[i].Eproduct_status%></span>

    <div class="product-image">
        <img
            src="/images/<%=all_products[i].Eprodcut_img%>"
            alt="Smartphone"
        >
    </div>

    <div class="product-info">
        <span class="product-category"><%=all_products[i].Eproduct_category%></span>
        <h3><%=all_products[i].Eproduct_name%></h3>

        <div class="product-rating">
            <% for(var a=0;a<all_products[i].Eproduct_rating;a++){ %>
                ★
            <% } %>
            <small>(<%=all_products[i].Eproduct_rating%>)</small>
        </div>

        <div class="product-price">
            ₹<span class="total-price"><%=all_products[i].Eproduct_new_price%></span>
            <del>₹<%=all_products[i].Eproduct_old_price%></del>
        </div>

        <!-- Size Selector -->
         <div class="size-box">
            <label>Select Size:</label>
            <select class="product-size">
                <option value="">Choose Size</option>
                <option value="28">28</option>
                <option value="30">30</option>
                <option value="32">32</option>
                <option value="34">34</option>
                <option value="36">36</option>
            </select>
        </div>


        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

            <input type="number"
                class="qty-input"
                value="1"
                readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

        <button type="button"
                class="product-cart-btn buy-now"
                data-id="<%=all_products[i].Eid%>"
                data-price="<%=all_products[i].Eproduct_new_price%>"
                data-url="/Pyment_electnocis_product/<%=all_products[i].Eid%>">

            <i class="fa-solid fa-cart-shopping"></i>
            Buy Now

        </button>
    </div>

</div>

            <% } %>

        </div>

    </section>

