<%-include('header.ejs')%>





    <!-- Products -->
    <section class="electronics-products" id="products">

        <div class="section-heading">
            <span>OUR Jens COLLECTION</span>
            <h2>Trending Jens</h2>
            <p>Explore our popular Jens products</p>
        </div>

        <div class="product-grid">

<% for(var i=0;i<all_products.length;i++){ %>
           
<div class="product-card">

    <span class="product-badge"><%=all_products[i].Eproduct_status%></span>

    <div class="product-image">
        <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/electronics_products/<%=all_products[i].Eprodcut_img%>" target="_blank">
            <img
                    src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/electronics_products/<%=all_products[i].Eprodcut_img%>"
                    alt="<%=all_products[i].Eproduct_name%>"
                >
        </a>
    </div>

    <div class="product-info">
        <span class="product-category"><%=all_products[i].Eproduct_category%></span>
        <h3><%=all_products[i].Eproduct_name%></h3>

        <div class="product-rating">
            <% for(var a=0;a<all_products[i].Eproduct_rating;a++){ %>
                ★
            <% } %>
            <small>(<%=all_products[i].Eproduct_rating%>)</small>
        </div>

        <div class="product-price">
            ₹<span class="total-price"><%=all_products[i].Eproduct_new_price%></span>
            <del>₹<%=all_products[i].Eproduct_old_price%></del>
        </div>

             <!-- Product Colour Selector -->
            <div class="product-color-box">

                <label>Select Colour:</label>

                <div class="product-colors">

                    <% 
                        var colors = [];
                        try {
                            colors = JSON.parse(all_products[i].Product_color || '[]');
                        } catch (e) {
                            colors = [];
                        }
                    %>

                    <% colors.forEach(function(color) { %>

                        <button type="button"
                                class="color-option"
                                data-color="<%= color %>"
                                style="padding:5px 12px; margin:4px; border:1px solid #ccc; border-radius:5px; cursor:pointer;">
                            <%= color %>
                        </button>

                    <% }) %>

                </div>

                <p class="selected-color">
                    Selected Colour: <span class="color-name">None</span>
                </p>

            </div>


        <!-- Size Selector -->
         <div class="size-box">
            <label>Select Size:</label>

            <select class="product-size">
                <option value="">Choose Size</option>

                <% 
                    var sizes = [];
                    try {
                        sizes = JSON.parse(all_products[i].Product_size || '[]');
                    } catch (e) {
                        sizes = [];
                    }
                %>

                <% sizes.forEach(function(size) { %>
                    <option value="<%= size %>"><%= size %></option>
                <% }) %>

            </select>
        </div>

         <!-- Available Stock -->
            <div class="available-stock">

                <% if (all_products[i].Product_stock > 0) { %>

                    <span style="color: green; font-weight: bold;">
                        Available Stock: <%= all_products[i].Product_stock %>
                    </span>

                <% } else { %>

                    <span style="color: red; font-weight: bold;">
                        Product Not Available
                    </span>

                <% } %>

            </div>


        <div class="quantity-box">

            <button type="button" class="qty-minus">−</button>

             <input type="number"
            class="qty-input"
            value="1"
            min="1"
            data-stock="<%= all_products[i].Product_stock %>"
            readonly>

            <button type="button" class="qty-plus">+</button>

        </div>

                  <!-- Buy Now -->
<% if (all_products[i].Product_stock > 0) { %>

    <button type="button"
            class="product-cart-btn buy-now"
            data-price="<%=all_products[i].Eproduct_new_price%>"
            data-stock="<%=all_products[i].Product_stock%>"
            data-url="/Pyment_electnocis_product/<%=all_products[i].Eid%>">

        <i class="fa-solid fa-cart-shopping"></i>
        Buy Now

    </button>

<% } else { %>

    <button type="button" class="product-cart-btn" disabled
            style="background: #999; cursor: not-allowed;">

        Product Not Available

    </button>

<% } %>

        
    </div>

</div>

            <% } %>

        

    </section>

</section>


<%-include('footer.ejs')%>
