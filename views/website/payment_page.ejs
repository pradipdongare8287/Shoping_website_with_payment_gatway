


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
// console.log("KEY:", "<%= process.env.key_id %>")
var options = {
    key:"rzp_test_TsWz88rJ6b5v9b",
// rzp_test_TsWz88rJ6b5v9b test key
// <%= process.env.key_id %>
    // Dynamic total amount
    amount: Number(<%= payment_amt.Product_New_price %>) * 100,
    
    currency: "INR",
    

    name: "Js Jens",

    description: "<%= payment_amt.Product_name %>",

    // Hide  Payment Option
    config: {
        display: {
            hide: [
                {
                    method: "emi",
                  
                },
                {
                method: "paylater"
                },
                {
                method: "wallet"
                },
                //  {
                // method: "netbanking"
                // },
            ],
            preferences: {
                show_default_blocks: true
            }
        }
    },

    handler: async function (response) {

    try {

        console.log("Payment Successful:", response.razorpay_payment_id);

        var result = await fetch('/save_order', {
            method: 'POST',

            headers: {
                'Content-Type': 'application/json'
            },

            body: JSON.stringify({
                payment_id: response.razorpay_payment_id,
                product_id: "<%= product_id %>",
                product_name: "<%= product_name %>",
                product_price: <%= payment_amt.Product_New_price %>,
                product_qty: <%= qty %>,
                product_size: "<%= size %>",
                product_img: "<%= product_img %>",
                product_folder: "<%= product_folder %>",
                product_type: "<%= product_type %>"
            })
        });

        var data = await result.json();

        console.log("Save Order Response:", data);

        if (result.ok && data.success) {

            window.location.replace('/account');

        } else {

            alert(data.message || 'Order could not be saved');

        }

    } catch (error) {

        console.error("Payment Handler Error:", error);

        alert("Something went wrong. Please check your order.");

    }
}
};

var rzp1 = new Razorpay(options);

rzp1.open();

</script>

