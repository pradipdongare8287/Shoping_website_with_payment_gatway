<%- include('header.ejs') %>

<link rel="stylesheet" href="/website/cart.css">

<section class="cart-page">

    <div class="cart-hero">
        <span>SHOPPING BAG</span>
        <h1>My Cart <i class="fa-solid fa-cart-shopping"></i></h1>
        <p>Review your items before placing your order.</p>
    </div>

    <div class="cart-container">

        <!-- Cart Items -->
        <div class="cart-products">

            <div class="cart-heading">
                <h2>Shopping Cart</h2>
                <span>2 Items</span>
            </div>

            <!-- Product 1 -->
            <div class="cart-item">

                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500"
                     alt="Watch">

                <div class="cart-product-info">
                    <h3>Premium Wrist Watch</h3>
                    <p>Color: Black</p>
                    <p>Category: Accessories</p>

                    <div class="cart-price">₹1,499</div>

                    <div class="quantity-control">
                        <button type="button">−</button>
                        <span>1</span>
                        <button type="button">+</button>
                    </div>
                </div>

                <button class="cart-remove">
                    <i class="fa-solid fa-trash"></i>
                </button>

            </div>

            <!-- Product 2 -->
            <div class="cart-item">

                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500"
                     alt="Shoes">

                <div class="cart-product-info">
                    <h3>Stylish Sneakers</h3>
                    <p>Color: White</p>
                    <p>Category: Fashion</p>

                    <div class="cart-price">₹2,299</div>

                    <div class="quantity-control">
                        <button type="button">−</button>
                        <span>1</span>
                        <button type="button">+</button>
                    </div>
                </div>

                <button class="cart-remove">
                    <i class="fa-solid fa-trash"></i>
                </button>

            </div>

            <a href="/shop" class="continue-shopping">
                <i class="fa-solid fa-arrow-left"></i>
                Continue Shopping
            </a>

        </div>

        <!-- Order Summary -->
        <div class="cart-summary">

            <h2>Order Summary</h2>

            <div class="summary-row">
                <span>Subtotal</span>
                <strong>₹3,798</strong>
            </div>

            <div class="summary-row">
                <span>Shipping</span>
                <strong class="free-shipping">FREE</strong>
            </div>

            <div class="summary-row">
                <span>Discount</span>
                <strong>−₹200</strong>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-total">
                <span>Total</span>
                <strong>₹3,598</strong>
            </div>

            <div class="coupon-box">
                <input type="text" placeholder="Enter coupon code">
                <button type="button">Apply</button>
            </div>

            <a href="/checkout" class="checkout-btn">
                Proceed to Checkout
                <i class="fa-solid fa-arrow-right"></i>
            </a>

            <div class="secure-checkout">
                <i class="fa-solid fa-lock"></i>
                Secure and safe checkout
            </div>

        </div>

    </div>

</section>

<%- include('footer.ejs') %>