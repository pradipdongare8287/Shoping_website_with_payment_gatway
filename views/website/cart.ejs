<%- include('header.ejs') %>

<link rel="stylesheet" href="/website/cart.css">

<section class="cart-page">

    <div class="cart-hero">
        <span>SHOPPING BAG</span>
        <h1>My Cart <i class="fa-solid fa-cart-shopping"></i></h1>
        <p>Review your items before placing your order.</p>
    </div>

    <div class="cart-container">

        <!-- Cart Items -->
        
<div class="cart-products">

    <div class="cart-heading">
        <h2>Shopping Cart</h2>
        <span><%= cart.length %> Items</span>
    </div>

    <% if (cart.length > 0) { %>

        <% cart.forEach(function(item) { 

            var imageFolder = '';

            if (item.Product_type === 'all_product') {
                imageFolder = 'products';
            }
            else if (item.Product_type === 'trending') {
                imageFolder = 'trending_products';
            }
            else if (item.Product_type === 'fashion') {
                imageFolder = 'fashion_products';
            }
            else if (item.Product_type === 'electronics') {
                imageFolder = 'electronics_products';
            }
            else if (item.Product_type === 'beauty') {
                imageFolder = 'beauty_products';
            }

        %>

            <div class="cart-item">

                <img src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/<%= imageFolder %>/<%= item.Product_img %>"
                     alt="<%= item.Product_name %>">

                <div class="cart-product-info">

                    <h3><%= item.Product_name %></h3>

                    <p>Category: <%= item.Product_type %></p>

                    <p>Size: <%= item.Product_size %></p>

                    <div class="cart-price">
                        Price: ₹<%= item.Product_price %>
                    </div>

                    <div class="cart-price">
                        Quantity: <%= item.Product_qty %>
                    </div>

                    <div class="cart-price">
                        Total: ₹<%= (
                            Number(item.Product_price) * Number(item.Product_qty)
                        ).toFixed(2) %>
                    </div>

                   
                </div>

                <a href="/delete_cart_item/<%= item.Cart_id %>" class="cart-remove">
                    <i class="fa-solid fa-trash"></i>
                </a>

            </div>

        <% }); %>

    <% } else { %>

        <div class="empty-cart">
            <h3>Your Cart is Empty!</h3>
            <p>Add some products to your shopping cart.</p>
        </div>

    <% } %>

    <a href="/" class="continue-shopping">
        <i class="fa-solid fa-arrow-left"></i>
        Continue Shopping
    </a>

</div>


        <%
    var grand_total = 0;
    

    cart.forEach(function(item) {
        grand_total += Number(item.Product_price) * Number(item.Product_qty);
    });
%>



<div class="cart-summary">

    <h2>Order Summary</h2>

    <div class="summary-row">
        <span>Subtotal</span>
        <strong>₹<%= grand_total.toFixed(2) %></strong>
    </div>

    <div class="summary-row">
        <span>Shipping</span>
        <strong class="free-shipping">FREE</strong>
    </div>

    <div class="summary-divider"></div>

    <div class="summary-total">
        <span>Total</span>
        <strong>₹<%= grand_total.toFixed(2) %></strong>
        <a href="/checkout" class="checkout-btn">
            Order Now &nbsp;&nbsp;
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
    </div>

<script>
document.querySelector('.checkout-btn').addEventListener('click', async function(e) {

    e.preventDefault();

    try {

        var response = await fetch('/save_cart_order', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        if (response.redirected) {
            window.location.href = response.url;
            return;
        }

        if (!response.ok) {
            throw new Error('Order request failed');
        }

        window.location.href = '/order_success';

    } catch (error) {

        console.log(error);
        alert('Something went wrong');

    }

});
</script>

</section>

<%- include('footer.ejs') %>