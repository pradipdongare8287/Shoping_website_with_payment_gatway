<%- include('header.ejs') %>

<link rel="stylesheet" href="/website/contact.css">

<section class="contact-page">

    <!-- HERO SECTION -->
    
<section style="
    width:100%;
    min-height:500px;
    padding:60px 7%;
    box-sizing:border-box;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:50px;
    background:linear-gradient(135deg,#fff8f3,#fce9dc);
    border-radius:20px;
    overflow:hidden;
    font-family:'Noto Sans Devanagari',sans-serif;
">

    <!-- LEFT CONTENT -->
    <div style="flex:1; max-width:600px;">

        <span style="
            display:inline-block;
            background:#ffe0cc;
            color:#d65a22;
            padding:10px 20px;
            border-radius:30px;
            font-size:14px;
            font-weight:bold;
            letter-spacing:1px;
        ">
            ✦ आम्ही सदैव तुमच्या सेवेत
        </span>

        <h1 style="
            font-size:clamp(32px,5vw,55px);
            line-height:1.4;
            color:#29211e;
            margin:25px 0 15px;
            font-weight:800;
        ">
            चला, करूया<br>
            <span style="color:#e76b35;">
                एक सुंदर संवाद!
            </span>
        </h1>

        <p style="
            font-size:17px;
            line-height:2;
            color:#655650;
            margin-bottom:30px;
        ">
            तुम्हाला काही प्रश्न आहेत का? आमच्या उत्पादनांबद्दल
            माहिती हवी आहे का? ऑर्डरविषयी काही मदत हवी असल्यास
            किंवा काही सूचना द्यायच्या असल्यास आम्हाला नक्की संपर्क करा.
            तुमचे समाधान हेच आमचे प्राधान्य आहे.
        </p>

        <a href="#contact-form" style="
            display:inline-block;
            text-decoration:none;
            background:#e76b35;
            color:white;
            padding:15px 30px;
            border-radius:10px;
            font-size:16px;
            font-weight:bold;
            box-shadow:0 8px 20px rgba(231,107,53,0.25);
        ">
            आमच्याशी संपर्क साधा
            <span style="margin-left:10px;">➜</span>
        </a>

        <div style="
            display:flex;
            flex-wrap:wrap;
            gap:25px;
            margin-top:35px;
        ">
            <div>
                <strong style="color:#e76b35;font-size:23px;">♡</strong>
                <span style="color:#55463f;font-size:14px;"> ग्राहकांचे समाधान</span>
            </div>

            <div>
                <strong style="color:#e76b35;font-size:23px;">✆</strong>
                <span style="color:#55463f;font-size:14px;"> तत्पर मदत</span>
            </div>
        </div>

    </div>

    <!-- RIGHT IMAGE -->
    <div style="
        flex:1;
        min-width:250px;
        max-width:480px;
        position:relative;
        text-align:center;
    ">

        <div style="
            width:90%;
            height:380px;
            margin:auto;
            border-radius:150px 150px 25px 25px;
            overflow:hidden;
            box-shadow:0 15px 40px rgba(0,0,0,0.15);
        ">
            <img
                src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=900&q=85"
                alt="ग्राहक सेवा टीम"
                style="
                    width:100%;
                    height:100%;
                    object-fit:cover;
                "
            >
        </div>

        <!-- FLOATING CARD -->
        <div style="
            position:absolute;
            bottom:25px;
            left:-10px;
            background:white;
            padding:18px 22px;
            border-radius:15px;
            display:flex;
            align-items:center;
            gap:13px;
            box-shadow:0 8px 30px rgba(0,0,0,0.12);
            text-align:left;
        ">

            <span style="
                width:45px;
                height:45px;
                background:#fff0e7;
                color:#e76b35;
                border-radius:50%;
                display:flex;
                align-items:center;
                justify-content:center;
                font-size:25px;
            ">♡</span>

            <div>
                <strong style="
                    display:block;
                    color:#29211e;
                    font-size:15px;
                ">
                    आम्ही ऐकण्यासाठी आहोत!
                </strong>

                <small style="color:#81736c;">
                    तुमचा विश्वास आमच्यासाठी महत्त्वाचा.
                </small>
            </div>

        </div>

    </div>

</section>



    <!-- CONTACT INFORMATION -->
    
<section style="
    width:100%;
    padding:70px 6%;
    box-sizing:border-box;
    background:#fff;
    font-family:'Noto Sans Devanagari',sans-serif;
">

    <!-- SECTION HEADING -->
    <div style="
        text-align:center;
        margin-bottom:50px;
    ">

        <span style="
            display:inline-block;
            color:#e76b35;
            background:#fff0e7;
            padding:9px 22px;
            border-radius:30px;
            font-size:13px;
            font-weight:bold;
            letter-spacing:1px;
        ">
            ✦ आमच्याशी जोडले जा
        </span>

        <h2 style="
            font-size:clamp(27px,4vw,40px);
            color:#29211e;
            margin:20px 0 12px;
            font-weight:800;
        ">
            आम्ही आहोत तुमच्या <span style="color:#e76b35;">सेवेसाठी!</span>
        </h2>

        <p style="
            color:#777;
            font-size:16px;
            line-height:1.8;
            margin:0;
        ">
            आमच्याशी संपर्क साधण्यासाठी तुमचा आवडता पर्याय निवडा.
            आम्ही तुमच्या मदतीसाठी सदैव तयार आहोत.
        </p>

    </div>


    <!-- CONTACT CARDS GRID -->
    <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
        gap:25px;
        max-width:1200px;
        margin:auto;
    ">

        <% contact.forEach((contact,index)=>{ %>

            <div style="
                background:#fffaf7;
                padding:35px 22px;
                border:1px solid #f5e5dc;
                border-radius:18px;
                text-align:center;
                transition:all 0.3s ease;
                box-shadow:0 5px 20px rgba(0,0,0,0.04);
            "
            onmouseover="this.style.transform='translateY(-8px)';this.style.boxShadow='0 15px 30px rgba(231,107,53,0.13)';this.style.borderColor='#e76b35'"
            onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 5px 20px rgba(0,0,0,0.04)';this.style.borderColor='#f5e5dc'"
            >

                <!-- ICON -->
                <div style="
                    width:75px;
                    height:75px;
                    margin:0 auto 22px;
                    background:#ffe9dc;
                    color:#e76b35;
                    border-radius:50%;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:30px;
                ">
                    <i class="<%=contact.contact_icon%>"></i>
                </div>

                <!-- TITLE -->
                <h3 style="
                    font-size:21px;
                    color:#29211e;
                    margin:0 0 12px;
                    font-weight:700;
                ">
                    <%=contact.contact_contact_name%>
                </h3>

                <!-- DESCRIPTION -->
                <p style="
                    color:#81736c;
                    font-size:14px;
                    line-height:1.8;
                    min-height:50px;
                    margin:0 0 20px;
                ">
                    <%=contact.contact_option_note%>
                </p>

                <!-- CONTACT LINK -->
                <a href="mailto:support@example.com" style="
                    display:inline-block;
                    text-decoration:none;
                    background:#e76b35;
                    color:white;
                    padding:12px 22px;
                    border-radius:8px;
                    font-size:14px;
                    font-weight:bold;
                    word-break:break-word;
                    transition:0.3s;
                ">
                    <%=contact.contact_text%>
                    <span style="margin-left:7px;">➜</span>
                </a>

            </div>

        <% }) %>

    </div>

</section>



    <!-- CONTACT FORM SECTION -->
  
<section id="contact-form" style="
    width:100%;
    padding:70px 6%;
    box-sizing:border-box;
    display:flex;
    flex-wrap:wrap;
    gap:45px;
    align-items:center;
    background:linear-gradient(135deg,#fff8f3,#fff);
    border-radius:20px;
    font-family:'Noto Sans Devanagari',sans-serif;
">

    <!-- LEFT CONTENT -->
    <div style="
        flex:1;
        min-width:270px;
        padding:20px;
    ">

        <span style="
            display:inline-block;
            color:#e76b35;
            background:#ffe9dc;
            padding:10px 20px;
            border-radius:30px;
            font-size:14px;
            font-weight:bold;
        ">
            ✦ संपर्क फॉर्म
        </span>

        <h2 style="
            font-size:clamp(32px,4vw,48px);
            line-height:1.5;
            color:#29211e;
            margin:25px 0 18px;
            font-weight:800;
        ">
            तुमचे विचार<br>
            <span style="color:#e76b35;">
                आमच्यापर्यंत पोहोचवा!
            </span>
        </h2>

        <p style="
            color:#71635d;
            font-size:16px;
            line-height:2;
            max-width:450px;
        ">
            तुमचा प्रश्न, सूचना किंवा अभिप्राय आम्हाला नक्की कळवा.
            खाली दिलेला फॉर्म भरा. आमची टीम लवकरात लवकर
            तुमच्याशी संपर्क साधेल.
        </p>

        <!-- DECORATION -->
        <div style="
            display:flex;
            gap:20px;
            margin-top:35px;
            font-size:35px;
            color:#e76b35;
        ">
            <span>✦</span>
            <span>♡</span>
            <span>✧</span>
        </div>

        <div style="
            margin-top:35px;
            padding:18px;
            background:#fff;
            border-left:4px solid #e76b35;
            border-radius:10px;
            max-width:380px;
            box-shadow:0 5px 20px rgba(0,0,0,0.04);
        ">
            <strong style="color:#29211e;font-size:16px;">
                ♡ तुमचे मत आमच्यासाठी महत्त्वाचे!
            </strong>

            <p style="
                margin:8px 0 0;
                color:#81736c;
                font-size:14px;
                line-height:1.8;
            ">
                तुमचा विश्वास आणि समाधान हीच आमची खरी कमाई आहे.
            </p>
        </div>

    </div>


    <!-- RIGHT FORM -->
    <div style="
        flex:1.2;
        min-width:280px;
        background:#fff;
        padding:35px;
        border-radius:20px;
        box-shadow:0 12px 40px rgba(0,0,0,0.07);
        border:1px solid #f5e5dc;
        box-sizing:border-box;
    ">

        <h3 style="
            color:#29211e;
            font-size:25px;
            margin:0 0 10px;
            font-weight:800;
        ">
            आम्हाला संदेश पाठवा
        </h3>

        <p style="
            color:#92847d;
            font-size:14px;
            margin-bottom:30px;
        ">
            कृपया खालील सर्व माहिती भरा.
        </p>


        <form action="/contact_save" method="POST">

            <!-- NAME AND EMAIL -->
            <div style="
                display:flex;
                flex-wrap:wrap;
                gap:18px;
            ">

                <div style="
                    flex:1;
                    min-width:180px;
                    margin-bottom:20px;
                ">
                    <label for="contact_name" style="
                        display:block;
                        color:#39302c;
                        font-size:14px;
                        font-weight:bold;
                        margin-bottom:10px;
                    ">
                        पूर्ण नाव
                    </label>

                    <input
                        type="text"
                        id="contact_name"
                        name="Customer_name"
                        placeholder="तुमचे पूर्ण नाव लिहा आणि शेवटी / मोबाईल नंबर पण टाका"
                        required
                        style="
                            width:100%;
                            padding:14px;
                            box-sizing:border-box;
                            border:1px solid #eaded7;
                            border-radius:9px;
                            outline:none;
                            background:#fffaf7;
                            font-size:14px;
                        "
                    >
                </div>


                <div style="
                    flex:1;
                    min-width:180px;
                    margin-bottom:20px;
                ">
                    <label for="contact_email" style="
                        display:block;
                        color:#39302c;
                        font-size:14px;
                        font-weight:bold;
                        margin-bottom:10px;
                    ">
                        ई-मेल पत्ता
                    </label>

                    <input
                        type="email"
                        id="contact_email"
                        name="Customer_email"
                        placeholder="तुमचा ई-मेल लिहा"
                        required
                        style="
                            width:100%;
                            padding:14px;
                            box-sizing:border-box;
                            border:1px solid #eaded7;
                            border-radius:9px;
                            outline:none;
                            background:#fffaf7;
                            font-size:14px;
                        "
                    >
                </div>

            </div>


            <!-- SUBJECT -->
            <div style="margin-bottom:20px;">

                <label for="contact_subject" style="
                    display:block;
                    color:#39302c;
                    font-size:14px;
                    font-weight:bold;
                    margin-bottom:10px;
                ">
                    विषय
                </label>

                <input
                    type="text"
                    id="contact_subject"
                    name="Customer_subject"
                    placeholder="संपर्क करण्याचे कारण लिहा"
                    required
                    style="
                        width:100%;
                        padding:14px;
                        box-sizing:border-box;
                        border:1px solid #eaded7;
                        border-radius:9px;
                        outline:none;
                        background:#fffaf7;
                        font-size:14px;
                    "
                >

            </div>


            <!-- MESSAGE -->
            <div style="margin-bottom:25px;">

                <label for="contact_message" style="
                    display:block;
                    color:#39302c;
                    font-size:14px;
                    font-weight:bold;
                    margin-bottom:10px;
                ">
                    तुमचा संदेश
                </label>

                <textarea
                    id="contact_message"
                    name="Customer_message"
                    rows="5"
                    placeholder="तुमचा संदेश येथे लिहा..."
                    required
                    style="
                        width:100%;
                        padding:14px;
                        box-sizing:border-box;
                        border:1px solid #eaded7;
                        border-radius:9px;
                        outline:none;
                        background:#fffaf7;
                        font-size:14px;
                        resize:vertical;
                        font-family:inherit;
                    "
                ></textarea>

            </div>


            <!-- SUBMIT BUTTON -->
            <button type="submit" style="
                width:100%;
                padding:16px;
                border:none;
                border-radius:10px;
                background:#e76b35;
                color:white;
                font-size:16px;
                font-weight:bold;
                cursor:pointer;
                box-shadow:0 7px 20px rgba(231,107,53,0.22);
            ">
                संदेश पाठवा <span style="margin-left:10px;">→</span>
            </button>


            <small style="
                display:block;
                text-align:center;
                color:#92847d;
                margin-top:20px;
                font-size:13px;
            ">
                ♡ तुमची वैयक्तिक माहिती आमच्याकडे सुरक्षित आहे.
            </small>

        </form>

    </div>

</section>



    <!-- BOTTOM BANNER -->
  
<section style="
    width:100%;
    padding:65px 20px;
    box-sizing:border-box;
    text-align:center;
    background:linear-gradient(135deg,#e76b35,#f49a68);
    border-radius:20px;
    margin:30px 0;
    font-family:'Noto Sans Devanagari',sans-serif;
">

    <!-- ICON -->
    <div style="
        width:75px;
        height:75px;
        margin:0 auto 22px;
        background:rgba(255,255,255,0.2);
        border:1px solid rgba(255,255,255,0.4);
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        color:white;
        font-size:38px;
    ">
        ♡
    </div>

    <!-- HEADING -->
    <h2 style="
        color:white;
        font-size:clamp(28px,4vw,42px);
        font-weight:800;
        margin:0 0 18px;
        line-height:1.5;
    ">
        तुमचा प्रत्येक संदेश आमच्यासाठी खास आहे!
    </h2>

    <!-- DESCRIPTION -->
    <p style="
        color:#fff8f3;
        font-size:16px;
        line-height:2;
        max-width:650px;
        margin:0 auto;
    ">
        आमच्या या प्रवासाचा एक भाग बनल्याबद्दल मनापासून धन्यवाद!
        तुमच्या प्रत्येक प्रश्नासाठी, सूचनेसाठी आणि मदतीसाठी
        आम्ही नेहमीच तुमच्या सोबत आहोत.
    </p>

    <!-- BOTTOM TEXT -->
    <div style="
        margin-top:30px;
        color:white;
        font-size:14px;
        font-weight:bold;
        letter-spacing:1px;
    ">
        ✦ तुमचा विश्वास, जबाबदारी आमची  ✦
    </div>

</section>


</section>

<%- include('footer.ejs') %>