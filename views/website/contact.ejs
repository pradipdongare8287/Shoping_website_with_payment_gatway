<%- include('header.ejs') %>

<link rel="stylesheet" href="/website/contact.css">

<section class="contact-page">

    <!-- HERO SECTION -->
    <section class="contact-hero">

        <div class="contact-hero-content">

            <span class="contact-label">
                ✦ WE'RE HERE FOR YOU
            </span>

            <h1>
                Let's Start<br>
                <span>A Conversation.</span>
            </h1>

            <p>
                Have a question, need help with an order, or just want
                to say hello? We'd love to hear from you.
            </p>

            <a href="#contact-form" class="contact-hero-btn">
                Get In Touch <span>↓</span>
            </a>

        </div>

        <div class="contact-hero-visual">

            <div class="contact-circle circle-one"></div>
            <div class="contact-circle circle-two"></div>

            <div class="contact-hero-image">
                <img
                    src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=900&q=85"
                    alt="Customer Support Team"
                >
            </div>

            <div class="contact-floating-card">
                <span>♡</span>
                <div>
                    <strong>We're Listening</strong>
                    <small>Your happiness matters.</small>
                </div>
            </div>

        </div>

    </section>


    <!-- CONTACT INFORMATION -->
    <section class="contact-info-section">

        <div class="contact-section-heading">
            <span>CONNECT WITH US</span>
            <h2>We're Just A Message Away</h2>
            <p>Choose the best way to get in touch with our team.</p>
        </div>

        <div class="contact-info-grid">

            <% contact.forEach((contact,index)=>{ %>

                <div class="contact-info-card">

                <div class="contact-info-icon"><i class="<%=contact.contact_icon%>"></i></div>

                <h3><%=contact.contact_contact_name%></h3>

                <p><%=contact.contact_option_note%></p>

                <a href="mailto:support@example.com">
                    <%=contact.contact_text%>
                </a>

            </div>

                
            <% }) %>
            

        </div>

    </section>


    <!-- CONTACT FORM SECTION -->
    <section class="contact-form-section" id="contact-form">

        <div class="contact-form-left">

            <span>CONTACT FORM</span>

            <h2>
                Tell Us<br>
                <em>What's On Your Mind.</em>
            </h2>

            <p>
                Fill out the form and our team will get back to you
                as soon as possible.
            </p>

            <div class="contact-form-decoration">
                <span>✦</span>
                <span>♡</span>
                <span>✧</span>
            </div>

        </div>


        <div class="contact-form-right">
 
            <form action="/contact_save" method="POST">

                <div class="contact-input-row">

                    <div class="contact-input-group">
                        <label for="contact_name">Full Name</label>

                        <input
                            type="text"
                            id="contact_name"
                            name="Customer_name"
                            placeholder="Enter your full name"
                            required
                        >
                    </div>

                    <div class="contact-input-group">
                        <label for="contact_email">Email Address</label>

                        <input
                            type="email"
                            id="contact_email"
                            name="Customer_email"
                            placeholder="Enter your email"
                            required
                        >
                    </div>

                </div>


                <div class="contact-input-group">
                    <label for="contact_subject">Subject</label>

                    <input
                        type="text"
                        id="contact_subject"
                        name="Customer_subject"
                        placeholder="What is this regarding?"
                        required
                    >
                </div>


                <div class="contact-input-group">
                    <label for="contact_message">Your Message</label>

                    <textarea
                        id="contact_message"
                        name="Customer_message"
                        rows="5"
                        placeholder="Write your message here..."
                        required
                    ></textarea>
                </div>


                <button type="submit" class="contact-submit-btn">
                    Send Message <span>→</span>
                </button>

                <small class="contact-form-note">
                    ♡ Your information is safe with us.
                </small>

            </form>

        </div>

    </section>


    <!-- BOTTOM BANNER -->
    <section class="contact-bottom-banner">

        <div class="contact-bottom-icon">♡</div>

        <h2>Every Message Matters.</h2>

        <p>
            Thank you for being a part of our journey.
            We're always happy to help.
        </p>

    </section>

</section>

<%- include('footer.ejs') %>