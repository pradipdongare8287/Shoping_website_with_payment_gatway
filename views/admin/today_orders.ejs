<%-include('header.ejs')%>
<div class="orders-container">

    <!-- Page Header -->
    <div class="page-header">

        <div>
            <span class="header-tag">ADMIN DASHBOARD</span>
            <h1>Today's Orders</h1>
            <p>Manage and monitor all orders received today.</p>
        </div>

        <div class="order-count">
            <span>Total Orders Today</span>
            <h2><%=today_all_orders.length %></h2>
        </div>

    </div>


    <!-- Orders Table -->
    <div class="table-card">

        <div class="table-heading">
            <div>
                <h2>Recent Orders</h2>
                <p>All customer orders placed today</p>
            </div>

            <span class="live-badge">
                <span class="live-dot"></span>
                Today's Orders
            </span>
        </div>


        <div class="table-responsive">

            <table>

                <thead>
                    <tr>
                        <th>SR.NO</th>
                        <th>PRODUCT</th>
                        <th>PRODUCT SIZE</th>
                        
                        <th>PRODUCT NAME</th>
                        <th>CUSTOMER</th>
                        <th>QTY</th>
                        <th>Paid Amount</th>
                        <th>ORDER DATE</th>
                        <th>ADDRESS</th>
                        <th>ORDER STATUS</th>
                        <th>PAYMENT</th>
                        <th>UPDATE PAYMENT STATUS</th>
                        <th>Action</th>

                    </tr>
                </thead>

            <tbody>

                    <% if (today_all_orders.length > 0) { %>

                        <% today_all_orders.forEach((order,index) => { %>

                            <tr>

                                <td>
                                    <%=index+1%>
                                </td>
                                <!-- Product Image -->
                                <td>
                                    <div class="product-image" style="width:auto;height:auto;">
                                        <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/<%= order.Product_folder %>/<%= order.Product_image %>" target="_blank">
                                            <img
                                                src="https://res.cloudinary.com/sdz5u7v8/image/upload/<%= order.Product_folder %>/<%= order.Product_image %>"
                                                alt="<%= order.Product_name %>"
                                                style="height:100px;width:130px;object-fit:contain;"
                                            >
                                        </a>
                                    </div>
                                </td>

                                <td>
                                    <%= order.Product_size %>
                                </td>
                                


                            


                                <!-- Product Name -->
                                <td>
                                    <span class="product-name">
                                        <%= order.Product_name %>
                                    </span>
                                </td>

                                <!-- Customer -->
                                <td>
                                    <div class="customer-info">
                                        <strong><%= order.customer_name %></strong>
                                        <a href="tel:+91<%= order.customer_mobile %>" class="call-btn">
                                        <i class="fa-solid fa-phone"></i> Call Now <%= order.customer_name %>
                                        </a>
                                        <%= order.customer_mobile %>
                                    </div>
                                </td>
                                <!-- <td>
                                    <a href="tel:+<%= order.customer_mobile %>" class="call-btn">
                                        <i class="fa-solid fa-phone"></i> Call Now
                                    </a>
                                    <%= order.customer_mobile %>
                                </td> -->

                                <!-- Quantity -->
                                <td>
                                    <span class="qty-badge">
                                        <%= order.Product_qty %>
                                    </span>
                                </td>


                                <!-- Price -->
                                <td>
                                    <strong class="price">
                                        ₹<%= order.Product_price %>
                                    </strong>
                                </td>


                                <!-- Date -->
                                <td>
                                    <span class="date-text">
                                        <%
    var orderDate = String(order.Order_date);
    var parts = orderDate.split(/[- :T]/);

    var year = parts[0];
    var month = parts[1];
    var day = parts[2];

    var hour = Number(parts[3]);
    var minute = parts[4];
    var second = parts[5];

    var ampm = hour >= 12 ? 'PM' : 'AM';

    var displayHour = hour % 12 || 12;

    var formattedDate =
        day + '/' + month + '/' + year + ' ' +
        String(displayHour).padStart(2, '0') + ':' +
        minute + ':' + second + ' ' + ampm;
%>

 Order Date: <%= formattedDate %>
                                    </span>
                                </td>


                                <!-- Address -->
                                <td>
                                    <div class="address-text">
                                        <%= order.customer_address %>
                                    </div>
                                </td>


                                <!-- Order Status -->
                                <td>
                                    <span class="status-badge
                                        <%= order.Order_status === 'Placed' ? 'placed' :
                                            order.Order_status === 'Delivered' ? 'delivered' :
                                            order.Order_status === 'Cancelled' ? 'cancelled' : 'processing' %>">

                                        <%= order.Order_status %>

                                    </span>
                                </td>


                                <!-- Payment Status -->
                                <td>
                                    
                                    <% if(order.Payment_status=='PAID') {%>
                                        <span class="payment-badge" style="background-color:rgba(15, 211, 15,0.5);">

                                        PAID

                                    </span>
                                    <% } else { %>

                                        <span class="payment-badge" style="background-color:rgba(214, 50, 9,0.5);">

                                        UNPAID

                                    </span>

                                        <% } %>
                                </td>


                                <!-- Payment ID -->
                                <td>
                                    <a href="/admin/update_payment_status/<%= order.Order_id %>">
                                    <button onclick="saveScrollPosition()" style="padding:3px;font-size:14px;width:60px;background-color:green;">
                                        PAID
                                    </button><br/>
                                    </a>
                                    <a href="/admin/unpaid_payment_status/<%= order.Order_id %>">
                                    <button onclick="saveScrollPosition()" style="padding:3px;font-size:14px;width:60px;background-color:rgba(214, 44, 14, 0.788);margin-top:12px;">
                                        UNPAID
                                    </button>
                                    </a>
                                </td>
                            <td>
                                <a href="/admin/delete_order/<%= order.Order_id %>">
                                    
                                    <i title="Delete order" onclick="saveScrollPosition()" style="font-size:17px;color:red;" class="fa fa-trash"></i>
                                    
                                </a>

                                <% if(order.Order_status=="Booked"){ %>
                                    <a href="/admin/confirm_order/<%= order.Order_id %>" onclick="saveScrollPosition()" >
                                        <button title="Confirm Order" style="background-color:orange;padding:5px;margin:3px;font-size:15px;border:2px solid rgb(243, 131, 4);">
                                            Confirm Order
                                        </button>        
                                    </a>
                                <% } else if(order.Order_status=="Confirm") {%>
                                    <a href="/admin/dispatched_order/<%= order.Order_id %>">
                                <button title="Dispatched Order" onclick="saveScrollPosition()" style="background-color:rgba(25, 197, 53, 0.822);padding:5px;margin:3px;font-size:15px;border:2px solid green;">
                                    Order Dispatched
                                </button>        
                                </a>
                                <% }else {%>

                                <% } %>
                        
                                
                            </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>
                            <td colspan="10" class="empty-orders">
                                <div class="empty-icon">📦</div>
                                <h3>No Orders Today!</h3>
                                <p>New orders will appear here.</p>
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

        <div class="table-footer">
            Showing <strong><%=today_all_orders.length %></strong> orders for today.
        </div>

    </div>

</div>

<script>
    function saveScrollPosition() {
        sessionStorage.setItem('orderScrollPosition', window.scrollY);
    }

    window.addEventListener('load', function () {
        var scrollPosition = sessionStorage.getItem('orderScrollPosition');

        if (scrollPosition !== null) {
            window.scrollTo(0, parseInt(scrollPosition));
            sessionStorage.removeItem('orderScrollPosition');
        }
    });
</script>
<%-include('footer.ejs')%>
