<%-include('header.ejs')%>



<div class="contact-container">

    <div class="form-header">
        <h2>Add Contact Option</h2>
        <p>Create a new contact option</p>
    </div>

    <form action="/admin/save_contact_option" method="POST">

        <div class="form-group">
            <label>Contact Icon</label>
            <input type="text" name="Contact_icon"
                placeholder="Example: fa-solid fa-phone" required>
            <small>Enter Font Awesome icon class</small>
        </div>

        <div class="form-group">
            <label>Contact Name</label>
            <input type="text" name="Contact_name"
                placeholder="Enter Contact Name" required>
        </div>

        <div class="form-group">
            <label>Option Note</label>
            <input type="text" name="Option_note"
                placeholder="Enter Option Note" required>
        </div>

        <div class="form-group">
            <label>Contact Text</label>
            <textarea name="Contact_text"
                placeholder="Enter Contact Text" rows="4" required></textarea>
        </div>

        <button type="submit">Save Contact Option</button>

    </form>

</div>

<%-include('footer.ejs')%>
