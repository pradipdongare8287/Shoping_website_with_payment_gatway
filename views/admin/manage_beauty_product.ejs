<%-include('header.ejs')%>
<div class="beauty-table-container">

    <!-- Table Header -->
    <div class="beauty-table-header">
        <div>
            <h2>Manage Beauty Products</h2>
            <p>View, edit and manage all beauty products</p>
        </div>

        <a href="/admin/add_beauty_product"
           class="beauty-add-btn">
            <i class="fa-solid fa-plus"></i>
            Add Product
        </a>
    </div>

    <!-- Search -->
    <div class="beauty-search-box">
        <i class="fa-solid fa-magnifying-glass"></i>

        <input type="text"
               id="beautySearch"
               placeholder="Search product, category or brand...">
    </div>

    <!-- Table -->
    <div class="beauty-table-responsive">

        <table class="beauty-manage-table" id="beautyTable">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Status</th>
                    <th>Rating</th>
                    <th>Price</th>
                    <th>Skin Type</th>
                    <th>Quantity</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <!-- Sample Product 1 -->
                 <% for(var i=0;i<product.length;i++){ %>
                <tr>
                    <td><%=i+1 %></td>

                    <td>
                        <div class="beauty-product-info">
                            <img src="/images/<%=product[i].Prdouct_image%>"
                                 alt="Product Image">

                            <span><%=product[i].product_name%></span>
                        </div>
                    </td>

                    <td><%=product[i].product_category%></td>
                    <td><%=product[i].product_brand%></td>

                    <td>
                        <span class="beauty-status new">
                            <%=product[i].Product_Status%>
                        </span>
                    </td>

                    <td>
                        <span class="beauty-rating">
                            <% for(var a=0;a<product[i].product_rating;a++){ %>
                            <i class="fa-solid fa-star"></i>
                            <% } %>
                            <%=product[i].product_rating%>
                        </span>
                    </td>

                    <td>
                        <div class="beauty-price">
                            <strong>₹<%=product[i].product_new_price%></strong>
                            <del>₹<%=product[i].product_old_price%></del>
                        </div>
                    </td>

                    <td><%=product[i].product_skin_type%></td>
                    <td><%=product[i].product_quantity%></td>

                    <td>
                        <div class="beauty-action-buttons">

                            <a href="/admin/edit_beauty_product/1"
                               class="beauty-edit-btn"
                               title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </a>

                            <a href="/admin/delete_beauty_product/<%=product[i].pid%>/<%=product[i].Prdouct_image%>"
                               class="beauty-delete-btn"
                               title="Delete"
                               onclick="return confirm('Are you sure you want to delete this product?')">
                                <i class="fa-solid fa-trash"></i>
                            </a>

                        </div>
                    </td>
                </tr>

                <% } %>
            

            </tbody>

        </table>

    </div>

</div>

<!-- Search Script -->
<script>
    const beautySearch = document.getElementById("beautySearch");

    beautySearch.addEventListener("keyup", function () {

        const searchValue = this.value.toLowerCase();

        const rows = document.querySelectorAll(
            "#beautyTable tbody tr"
        );

        rows.forEach(function (row) {

            const rowText = row.innerText.toLowerCase();

            row.style.display = rowText.includes(searchValue)
                ? ""
                : "none";

        });

    });
</script>
<%-include('footer.ejs')%>
