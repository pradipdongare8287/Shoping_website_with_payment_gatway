        <div class="electronics-form-grid">

            <!-- Product Status -->
            <div class="electronics-form-group">
                <label>Product Status</label>
                <select name="product_status">
                    <option value="">Select Status</option>
                    <option value="Fast Sale">Fast Sale</option>
                    <option value="New">New</option>
                    <option value="Hot">Hot</option>
                </select>
            </div>

            <!-- Product Image -->
            <div class="electronics-form-group">
                <label>Product Image</label>
                <input type="file"
                       name="product_img"
                       accept="image/*"
                       required>
            </div>

            <!-- Product Category -->
            <div class="electronics-form-group">
                <label>Jeans Product Category</label>
                <select name="product_category" required>
                    <option value="">Select Category</option>
                    <option value="Gray Jens">Gray Jens</option>
                    <option value="Plain Jens">Plain Jens</option>
                    <option value="Strechibal Jens">Strechibal Jens</option>
                    <option value="Popcorn Armani">Pudhari Armani</option>
                    <option value="Black Jeans">Black Jeans</option>
                    <option value="Blue Jens">Blue Jens</option>
                    <option value="Double-Stitched Pants">Double-Stitched Pants</option>
                    <option value="Cut Size Jeans">Cut Size Jeans</option>
                    
                </select>
            </div>

            <!-- Product Name -->
            <div class="electronics-form-group">
                <label>Product Name</label>
                <input type="text"
                       name="product_name"
                       placeholder="Enter product name"
                       required>
            </div>

