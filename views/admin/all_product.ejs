
<%- include('header.ejs') %>

<div class="product-table-container">

    <!-- HEADER -->
    <div class="product-table-header">
        <div>
            <h2>सर्व कपडे </h2>
            <p>Manage your store products</p>
        </div>

        <a href="/admin/add_product" class="add-product-btn">
            <i class="fa-solid fa-plus"></i>
            Add Product
        </a>
    </div>

    <!-- TABLE -->
    <div class="product-table-wrapper">

        <table class="product-table">

            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>Status</th>
                    <th>Image</th>
                    <th>QTY</th>
                    <th>Category</th>
                    <th>Product Name</th>
                    <th>Rating</th>
                    <th>Reviews</th>
                    <th>New Price</th>
                    <th>Old Price</th>
                    
                    <th>Product Size</th>

                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <!-- SAMPLE PRODUCT 1 -->
                 <% for(var i=0;i<products.length;i++){ %>
                    <tr>
                    <td><%=i+1%></td>

                    <td>
                        <span class="product-status sale"><%=products[i].Product_status%></span>
                    </td>

                    <td>
                        <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/products/<%= products[i].Product_img %>" target="_blank">
                            <img
                                src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/products/<%= products[i].Product_img %>"
                                class="product-table-img"
                                alt="Product">
                        </a>
                    </td>
                    <td><%=products[i].Product_stock%></td>

                    <td><%=products[i].Product_category%></td>

                    <td class="product-name">
                       <%=products[i].Product_name%>
                    </td>

                    <td>
                        <span class="product-rating">
                           <% for(var a=0; a<products[i].Product_rating; a++){ %>
                                <i class="fa-solid fa-star"></i>
                            <% } %>
                            <%=products[i].Product_rating %>
                        </span>
                    </td>

                    <td><%=products[i].Product_review %></td>

                    <td class="new-price"><%=products[i].Product_New_price %></td>

                    <td class="old-price"><%=products[i].Product_Old_price %></td>
                   
                    <td>
                        <% 
                            var colors = [];
                            try {
                                colors = JSON.parse(products[i].Product_size || '[]');
                            } catch (e) {
                                colors = [];
                            }
                        %>

                        <% colors.forEach(function(color) { %>

                            <span style="display:inline-block; background:#e8e8e8; color:#222; padding:4px 9px; margin:3px; border-radius:6px; font-size:12px;">
                                <%= color %>
                            </span>

                        <% }) %>
                    </td>


                    <td>
                        <div class="product-action-buttons">

                            <a href="/admin/delete_product/<%=products[i].Pid %>/<%=products[i].Product_img%>"
                               class="delete-product-btn"
                               title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                    <% } %>
                

                <!-- SAMPLE PRODUCT 2 -->
           

             

            </tbody>

        </table>

    </div>

</div>

<%- include('footer.ejs') %>

