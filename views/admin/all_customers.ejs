<%-include('header.ejs')%>

<div class="users-container">

    <div class="users-header">
        <div>
            <h2>Manage All Users</h2>
            <p>View and manage registered customers</p>
        </div>

        <div class="users-count">
            <i class="fa-solid fa-users"></i>
            All Users
        </div>
    </div>

    <div class="users-table-wrapper">

        <table class="users-table">

            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>User Name</th>
                    <th>Email</th>
                    <th>Password</th>
                    <th>Mobile</th>
                    <th>Account Status</th>
                    <th>Address</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <% for(var i = 0; i < users.length; i++) { %>

                <tr>

                    <td><%= i + 1 %></td>

                    <td class="user-name">
                        <%= users[i].user_name %>
                    </td>

                    <td><%= users[i].user_email %></td>

                    <td><%= users[i].user_password %></td>

                    <td><%= users[i].user_mobile %></td>

                    <td>
                        <span class="user-status">
                            <%= users[i].user_account_status %>
                        </span>
                    </td>

                    <td class="user-address">
                        <%= users[i].user_address %>
                    </td>

                    <td>
                        <div class="user-action-buttons">

                            <a href="/admin/edit_user/<%= users[i].Uid %>"
                               class="user-edit-btn"
                                title="Edit User">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>

                            <a href="/admin/delete_user/<%= users[i].Uid %>"
                               class="user-delete-btn"
                               title="Delete User"
                               onclick="return confirm('Are you sure you want to delete this user?')">
                                <i class="fa-solid fa-trash"></i>
                            </a>

                        </div>
                    </td>

                </tr>

                <% } %>

            </tbody>

        </table>

    </div>

</div>

<%-include('footer.ejs')%>

