<%-include('header.ejs')%>
<div class="electronics-table-container">

    <!-- Table Header -->
    <div class="electronics-table-header">
        <div>
            <h2>Manage Electronics Products</h2>
            <p>View, edit and manage all electronics products</p>
        </div>

        <a href="/admin/add_electronics_product"
           class="electronics-add-btn">
            <i class="fa-solid fa-plus"></i>
            Add Product
        </a>
    </div>

    <!-- Search -->
    <div class="electronics-search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text"
               id="electronicsSearch"
               placeholder="Search product, category or brand...">
    </div>

    <!-- Table -->
    <div class="electronics-table-responsive">

        <table class="electronics-manage-table" id="electronicsTable">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Status</th>
                    <th>Rating</th>
                    <th>Price</th>
                    <th>Warranty</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <!-- Sample Product 1 -->
                <% for(i=0;i<E_prodcts.length;i++) { %>
                <tr>
                    <td><%=i+1 %></td>

                    <td>
                        <div class="electronics-product-info">
                            <img src="/images/<%=E_prodcts[i].Eprodcut_img%>"
                                 alt="Product Image">

                            <span><%=E_prodcts[i].Eproduct_name%></span>
                        </div>
                    </td>

                    <td><%=E_prodcts[i].Eproduct_category%></td>
                    <td><%=E_prodcts[i].Eproduct_brand%></td>

                    <td>
                        <span class="electronics-status new">
                        <%=E_prodcts[i].Eproduct_status%>
                        </span>
                    </td>

                    <td>
                        <span class="electronics-rating">
                            <i class="fa-solid fa-star"></i>
                        <%=E_prodcts[i].Eproduct_rating%>
                        </span>
                    </td>

                    <td>
                        <div class="electronics-price">
                            <strong>₹<%=E_prodcts[i].Eproduct_new_price%></strong>
                            <del>₹<%=E_prodcts[i].Eproduct_old_price%></del>
                        </div>
                    </td>

                    <td><%=E_prodcts[i].Eproduct_warranty%></td>

                    <td>
                        <div class="electronics-action-buttons">

                            <a href="/admin/edit_electronics_product/1"
                               class="electronics-edit-btn"
                               title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </a>

                            <a href="/admin/delete_electronics_product/<%=E_prodcts[i].Eid%>/<%=E_prodcts[i].Eprodcut_img%>"
                               class="electronics-delete-btn"
                               title="Delete"
                               onclick="return confirm('Are you sure you want to delete this product?')">
                                <i class="fa-solid fa-trash"></i>
                            </a>

                        </div>
                    </td>
                </tr>

                <% } %>
           

            </tbody>

        </table>

    </div>

</div>

<%-include('footer.ejs')%>
