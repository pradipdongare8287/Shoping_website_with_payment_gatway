<%-include('header.ejs')%>
<div class="message-container">

    <div class="message-header">
        <div>
            <h2>All Customer Messages</h2>
            <p>View and manage customer contact messages</p>
        </div>

        <div class="message-count">
            <i class="fa-solid fa-envelope"></i>
            All Messages
        </div>
    </div>

    <div class="message-table-wrapper">

        <table class="message-table">

            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <% for(var i = 0; i <pending.length;i++) { %>

                <tr>
                    <td><%= i + 1 %></td>

                    <td class="customer-name">
                        <%= pending[i].Customer_name %>
                    </td>

                    <td>
                        <%= pending[i].Customer_email %>
                    </td>

                    <td>
                        <%= pending[i].Customer_subject %>
                    </td>

                    <td class="customer-message">
                        <%= pending[i].Customer_message %>
                    </td>

                    <td>
                        <span class="message-status">
                                <span style="color:orange;">
                                    <%= pending[i].Message_status %>
                                </span>
                         

                        </span>
                    </td>

                    <td>
                        <div class="message-actions">

                            <a href="/admin/pending_customer_message/<%= pending[i].Mid %>"
                               class="message-view-btn"
                               title="Pending Message">
                               <button style="padding:5px;border-radius:10px;background-color:rgba(240, 4, 4,0.7);border:2px solid rgb(231, 31, 24);box-sizing:border-box;cursor:pointer;">Pending</button>
                                
                            </a>

                            <a href="/admin/reject_customer_message/<%= pending[i].Mid %>"
                               class="message-delete-btn"
                               title="Reject Message"
                               onclick="return confirm('Are you sure you want to Reject this message?')">
                               <button style="padding:5px;border-radius:10px;background-color:rgba(247, 26, 26, 0.4);border:2px solid red;box-sizing:border-box;cursor:pointer;">Reject</button>
                            </a>

                        </div>
                    </td>
                </tr>

                <% } %>

            </tbody>

        </table>

    </div>

</div>
<%-include('footer.ejs')%>
