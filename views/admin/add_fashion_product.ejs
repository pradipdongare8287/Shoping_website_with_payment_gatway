
<%- include('header.ejs') %>

<div class="fashion-form-container">

    <div class="fashion-form-header">
        <h2>Add Shirts's Product</h2>
        <p>Enter Shirt's product details below</p>
    </div>

    <form action="/admin/add_new_fashion_product" method="POST" enctype="multipart/form-data">

        <div class="fashion-form-grid">

            <!-- Product Status -->
            <div class="fashion-form-group">
                <label>Product Status</label>
                <input type="text" name="fashion_product_status"
                       min="0" step="0.01"
                       placeholder="Enter product Status" >
            </div>

            <!-- Product Image -->
            <div class="fashion-form-group">
                <label>Product Image</label>
                <input type="file" name="fashion_product_img" accept="image/*" required>
            </div>

            <!-- Category -->
            <div class="fashion-form-group">
                <label>Product Category</label>
                <select name="fashion_product_category" required>
                    <option value="">Select Category</option>
                    <option value="Checks">Checks</option>
                    <option value="Lining">Lining</option>
                    <option value="Jens">Jens</option>
                    <option value="Plain">Plain</option>

                </select>
            </div>

            <!-- Product Name -->
            <div class="fashion-form-group">
                <label>Product Name</label>
                <input type="text" name="fashion_product_name"
                       placeholder="Enter product name" required>
            </div>

            <!-- Rating -->
            <div class="fashion-form-group">
                <label>Product Rating</label>
                <input type="number" name="fashion_product_rating"
                       min="0" max="5" step="0.1"
                       placeholder="Example: 4.5" >
            </div>

            <!-- Reviews -->
            <div class="fashion-form-group">
                <label>Product Reviews</label>
                <input type="number" name="fashion_product_reviews"
                       min="0" placeholder="Enter review count" >
            </div>

            <!-- New Price -->
            <div class="fashion-form-group">
                <label>Product New Price</label>
                <input type="number" name="fashion_product_new_price"
                       min="0" step="0.01"
                       placeholder="Enter new price" required>
            </div>

            <!-- Old Price -->
            <div class="fashion-form-group">
                <label>Product Old Price</label>
                <input type="number" name="fashion_product_old_price"
                       min="0" step="0.01"
                       placeholder="Enter old price" required>
            </div>

        </div>

        <div class="fashion-form-buttons">
            <button type="submit" style="background-color:#202e48;" class="fashion-submit-btn">
                <i class="fa-solid fa-plus"></i> Add New Shirt / Jens Product
            </button>

            <button type="reset" class="fashion-reset-btn">
                Reset
            </button>
        </div>

    </form>

</div>



<%- include('footer.ejs') %>

