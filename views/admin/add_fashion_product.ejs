
<%- include('header.ejs') %>

<div class="fashion-form-container">

    <div class="fashion-form-header">
        <h2>Add New Shirts's Product</h2>
        <p>Enter Shirt's product details below</p>
    </div>

 
<form action="/admin/add_new_fashion_product" method="POST" enctype="multipart/form-data">

    <div class="fashion-form-grid">

        <!-- Product Status -->
        <div class="form-group">
            <label>Product Status</label>
            <input type="text" name="fashion_product_status"
                   min="0" step="0.01"
                   placeholder="Enter product Status">
        </div>

        <!-- Product Image -->
        <div class="form-group">
            <label>Product Image</label>
            <input type="file" name="fashion_product_img" accept="image/*" required>
        </div>

        <!-- Category -->
        <div class="form-group">
            <label>Product Category</label>
            <select name="fashion_product_category" required>
                <option value="">Select Category</option>
                <option value="Checks">Checks</option>
                <option value="Lining">Lining</option>
                <option value="Spatch">Spatch</option>
                <option value="Plain">Plain</option>
                <option value="Paper Cottan">Paper Cottan</option>
            </select>
        </div>

        <!-- Product Name -->
        <div class="form-group">
            <label>Product Name</label>
            <input type="text" name="fashion_product_name"
                   placeholder="Enter product name" required>
        </div>

        <!-- Rating -->
        <div class="form-group">
            <label>Product Rating</label>
            <input type="number" name="fashion_product_rating"
                   min="0" max="5" step="0.1"
                   placeholder="Example: 4.5">
        </div>

        <!-- Reviews -->
        <div class="form-group">
            <label>Product Reviews</label>
            <input type="number" name="fashion_product_reviews"
                   min="0" placeholder="Enter review count">
        </div>

        <!-- New Price -->
        <div class="form-group">
            <label>Product New Price</label>
            <input type="number" name="fashion_product_new_price"
                   min="0" step="0.01"
                   placeholder="Enter new price" required>
        </div>

        <!-- Old Price -->
        <div class="form-group">
            <label>Product Old Price</label>
            <input type="number" name="fashion_product_old_price"
                   min="0" step="0.01"
                   placeholder="Enter old price" required>
        </div>

        <!-- Product Qty -->
        <div class="form-group">
            <label for="Produt_qty">Product Qty</label>
            <input type="number"
                   name="Product_qty"
                   id="Produt_qty"
                   min="0"
                   step="0.01"
                   placeholder="Enter Product Qty"
                   required>
        </div>

        <!-- Product Size -->
        <div class="form-group">
            <label>Product Size</label>

            <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:10px;">

                <label><input type="checkbox" name="product_size" value="S"> S</label>
                <label><input type="checkbox" name="product_size" value="M"> M</label>
                <label><input type="checkbox" name="product_size" value="L"> L</label>
                <label><input type="checkbox" name="product_size" value="XL"> XL</label>
                <label><input type="checkbox" name="product_size" value="XXL"> XXL</label>
                <label><input type="checkbox" name="product_size" value="3XL"> 3XL</label>
                <label><input type="checkbox" name="product_size" value="4XL"> 4XL</label>

            </div>
        </div>

        <!-- Product Colour -->
        <div class="form-group">
            <label>Product Colour</label>

            <div style="display:flex; gap:15px; flex-wrap:wrap; margin-top:10px;">

                <label>
                    <input type="checkbox" name="product_color" value="Black" style="width:16px; height:16px;">
                    Black
                </label>

                <label>
                    <input type="checkbox" name="product_color" value="Blue" style="width:16px; height:16px;">
                    Blue
                </label>

                <label>
                    <input type="checkbox" name="product_color" value="White" style="width:16px; height:16px;">
                    White
                </label>

                <label>
                    <input type="checkbox" name="product_color" value="Grey" style="width:16px; height:16px;">
                    Grey
                </label>

                <label>
                    <input type="checkbox" name="product_color" value="Red" style="width:16px; height:16px;">
                    Red
                </label>

                <label>
                    <input type="checkbox" name="product_color" value="Green" style="width:16px; height:16px;">
                    Green
                </label>

                <label>
                    <input type="checkbox" name="product_color" value="Navy Blue" style="width:16px; height:16px;">
                    Navy Blue
                </label>

            </div>
        </div>

    </div>

    <!-- FORM BUTTONS -->
    <div class="fashion-form-buttons">
        <button type="submit" style="background-color:#202e48;" class="fashion-submit-btn">
            <i class="fa-solid fa-plus"></i> Add New Shirt Product
        </button>

        <button type="reset" class="fashion-reset-btn">
            Reset Fill Shirt Product
        </button>
    </div>

</form>

</div>



<%- include('footer.ejs') %>

