<%-include('header.ejs')%>


<div class="orders-container">

    <h2 class="orders-title">All Customer Orders</h2>

    <div class="orders-table-wrapper">

        <table class="orders-table">

            <thead>
                <tr>
                    <th>Sr.no</th>
                    <th>Product Image</th>
                    <th>Customer Name</th>
                    <th>Customer Mobile</th>
                    <th>Product Name</th>
                    <th>Product QTY</th>
                    <th>Product Price</th>
                    <th>Order Date</th>
                    <th>Address</th>
                    <th>Order Status</th>
                    <th>Payment Status</th>
                    <th>Payment ID</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <% orders.forEach((order,index) => { %>

                    <tr>
                        <td><%= index+1 %></td>
                        <td>
                            <a href="images/<%= order.Product_image %>" target="_blank">
                                <img style="height:100px;width:130px;" src="images/<%= order.Product_image %>"/>
                            </a>
                        </td>

                        <td><%= order.customer_name %></td>

                        <td><%= order.customer_mobile %></td>

                        <td><%= order.Product_name %></td>

                        <td><%= order.Product_qty %></td>


                        <td><span style="background-color:rgba(21, 207, 21,0.3);padding:4px;border-radius:20px;color:green;">
                            ₹ <%= order.Product_price %>
                        </span></td>

                        <td>
                            <%= new Date(String(order.Order_date).replace(' ', 'T')).toLocaleString('en-IN', {
                                day: '2-digit',
                                month: '2-digit',
                                year: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit',
                                second: '2-digit',
                                hour12: true,
                                timeZone: 'Asia/Kolkata'
                            }) %>
                        </td>

                        <td><%= order.customer_address %></td>

                        <td>
                            
                            <% if(order.Order_status=='Confirm'){ %>
                                <span class="order-status" style="background-color:rgb(253, 174, 27);color:white;">
                                <%= order.Order_status %>
                            </span>
                            <% } else if(order.Order_status=='Order Dispatched'){ %>
                                <span class="order-status" style="background-color:green;color:white;">
                                <%= order.Order_status %>
                            </span>
                            <% }else if(order.Order_status=='Booked') { %>
                                <span class="order-status" style="background-color:rgb(235, 57, 12);color:white;">
                                <%= order.Order_status %>
                            </span>
                                <% } %>
                        </td>

                        <td style="color:rgb(11, 219, 11);"><%= order.Payment_status %></td>

                        <td><%= order.Payment_id %></td>

                        <td>
                            <a href="/admin/delete_order/<%= order.Order_id %>">
                                <i title="Delete order" style="font-size:17px;color:red;" class="fa fa-trash"></i>
                                
                            </a><br>
                              <% if(order.Order_status=="Booked"){ %>
                                <a href="/admin/confirm_order/<%= order.Order_id %>">
                                    <button title="Confirm Order" style="background-color:orange;padding:5px;margin:3px;font-size:15px;border:2px solid rgb(243, 131, 4);">
                                        Confirm Order
                                    </button>        
                            </a
                            <% } else if(order.Order_status=="Confirm") {%>
                                <a href="/admin/dispatched_order/<%= order.Order_id %>">
                            <button title="Dispatched Order" style="background-color:rgba(25, 197, 53, 0.822);padding:5px;margin:3px;font-size:15px;border:2px solid green;">
                                Order Dispatched
                            </button>        
                            </a>
                            <% }else {%>

                            <% } %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>


<%-include('footer.ejs')%>
