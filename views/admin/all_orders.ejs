<%-include('header.ejs')%>

<div class="orders-container">

    <div class="orders-header">
        <div>
            <h2>All Orders</h2>
            <p>Track and manage all customer orders</p>
        </div>

        <div class="orders-count">
            <i class="fa-solid fa-box"></i>
            All Orders
        </div>
    </div>

    <div class="orders-table-wrapper">
        <table class="orders-table">

            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>Order ID</th>
                    <th>Quantity</th>
                    <th>Order Date</th>
                    <th>Prodcut Price</th>
                    <th>Payment Status</th>
                    <th>Order Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% for(var i = 0; i < orders.length; i++) { %>
                <tr>

                    <td><%= i + 1 %></td>

                    <td class="order-id">
                        #<%= orders[i].Order_id %>
                    </td>
                    
                    <td><%= orders[i].Product_qty %></td>

                    <td class="order-amount">
                        <%= orders[i].Order_date %>
                    </td>
                    <td>
                        <span class="payment-status paid">
                            +<%= orders[i].Product_price %>
                        </span>
                    </td>

                    <td>
                        <span class="payment-status paid">
                            <%= orders[i].Payment_status %>
                        </span>
                    </td>

                    <td>
                        <span class="order-status delivered">
                            <%= orders[i].Order_status %>
                        </span>
                    </td>

                    <td>
                        <div class="order-action-buttons">

                            <a href="/admin/view_order/<%= orders[i].Order_id %>"
                               class="order-view-btn"
                               title="View Order">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <a href="/admin/delete_order/<%= orders[i].Order_id %>"
                               class="order-delete-btn"
                               title="Delete Order"
                               onclick="return confirm('Are you sure you want to delete this order?')">
                                <i class="fa-solid fa-trash"></i>
                            </a>

                        </div>
                    </td>

                </tr>
                <% } %>
            </tbody>

        </table>
    </div>

</div>

<%-include('footer.ejs')%>
