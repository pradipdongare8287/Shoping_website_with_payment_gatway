<%-include('header.ejs')%>
<div class="table-responsive">

<table class="admin-table">
    <thead>
        <tr>
            <th>Sr.No</th>
            <th>Admin Photo</th>
            <th>Admin Name</th>
            <th>Admin Email</th>
            <th>Admin Mobile</th>
            <th>Added Date</th>
            <th>Password</th>
            <th>Admin Role</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        <% all_admin.forEach((admin, index) => { %>
            <tr>
                <td><%= index + 1 %></td>

                <td>
                    <img style="height:55px;width:55px;" src="/images/<%= admin.Admin_photo %>" class="admin-img">
                </td>

                <td><%= admin.Admin_name %></td>
                <td><%= admin.Admin_email %></td>
                <td><%= admin.Admin_mobile %></td>
                <td><%= admin.Admin_added_date %></td>
                <td><%= admin.Admin_password %></td>
                <td>
                    <span class="role-badge <%= admin.Admin_role === 'Owner' ? 'owner' : 'admin' %>">
                        Employee
                    </span>
                </td>

                <td>
                    <a href="/admin/create_owner/<%= admin.Aid %>" style="background-color:green;" class="edit-btn">
                      Create Owner
                    </a>
                    <a href="/admin/delete_admin/<%= admin.Aid %>/<%= admin.Admin_photo %>" class="delete-btn">Delete Owner</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

</div>
<%-include('footer.ejs')%>

