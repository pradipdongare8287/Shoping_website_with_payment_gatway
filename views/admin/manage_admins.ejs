<%-include('header.ejs')%>
<div class="table-responsive">

<table class="admin-table">
    <thead>
        <tr>
            <th>Sr.No</th>
            <th>Admin Photo</th>
            <th>Admin Name</th>
            <th>Admin Email</th>
            <th>Admin Mobile</th>
            <th>Added Date</th>
            <th>Password</th>
            <th>Role</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        <% all_admin.forEach((admin, index) => { %>
            <tr>
                <td><%= index + 1 %></td>

                <td>
                    <a href="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/admin_users/<%= admin.Admin_photo %>" target="_blank">
                        <img
                            style="height:55px;width:55px;object-fit:cover;border-radius:50%;"
                            src="https://res.cloudinary.com/sdz5u7v8/image/upload/ecommerce/admin_users/<%= admin.Admin_photo %>"
                            class="admin-img"
                            alt="Admin Photo">
                    </a>
                </td>

                <td><%= admin.Admin_name %></td>
                <td><%= admin.Admin_email %></td>
                <td><%= admin.Admin_mobile %></td>
                <td><%= admin.Admin_added_date %></td>
                <td><%= admin.Admin_password %></td>
                <td>
                    <span class="role-badge <%= admin.Admin_role === 'Owner' ? 'owner' : 'admin' %>">
                        Employee
                    </span>
                </td>

                <td>
                    <a href="/admin/create_owner/<%= admin.Aid %>"  onclick="return confirm('Are You Sure <%= admin.Admin_name %> Create Owner ')" style="background-color:green;" class="edit-btn">
                      Create Owner
                    </a>
                    <a href="/admin/delete_admin/<%= admin.Aid %>/<%= admin.Admin_photo %>" onclick="return confirm('Are You Sure Delete <%= admin.Admin_name %> Employee ')" class="delete-btn">Delete Employee</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

</div>
<%-include('footer.ejs')%>

