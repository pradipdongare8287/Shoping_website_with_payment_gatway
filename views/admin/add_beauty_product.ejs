<%-include('header.ejs') %>
<div class="beauty-form-container">

    <div class="beauty-form-header">
        <div class="beauty-header-icon">
            <i class="fa-solid fa-spa"></i>
        </div>

        <div>
            <h2>Add Beauty Product</h2>
            <p>Enter beauty product details below</p>
        </div>
    </div>

    <form action="/admin/add_new_beauty_product"
          method="POST"
          enctype="multipart/form-data">

        <div class="beauty-form-grid">

            <!-- Product Status -->
            <div class="beauty-form-group">
                <label>Product Status</label>
                <input type="text" name="Product_Status" placeholder="Enter Product Status (popular , New , Best Seller)"/>
            </div>

            <!-- Product Image -->
            <div class="beauty-form-group">
                <label>Product Image</label>
                <input type="file"
                       name="product_img"
                       accept="image/*"
                       required>
            </div>

            <!-- Product Category -->
            <div class="beauty-form-group">
                <label>Product Category</label>
                <select name="product_category" required>
                    <option value="">Select Category</option>
                    <option value="Skin Care">Skin Care</option>
                    <option value="Hair Care">Hair Care</option>
                    <option value="Makeup">Makeup</option>
                    <option value="Body Care">Body Care</option>
                    <option value="Fragrance">Fragrance</option>
                    <option value="Beauty Tools">Beauty Tools</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <!-- Product Name -->
            <div class="beauty-form-group">
                <label>Product Name</label>
                <input type="text"
                       name="product_name"
                       placeholder="Enter product name"
                       required>
            </div>

            <!-- Brand -->
            <div class="beauty-form-group">
                <label>Product Brand</label>
                <input type="text"
                       name="product_brand"
                       placeholder="Example: Lakme, Mamaearth"
                       required>
            </div>

            <!-- Rating -->
            <div class="beauty-form-group">
                <label>Product Rating</label>
                <input type="number"
                       name="product_rating"
                       min="0"
                       max="5"
                       step="0.1"
                       placeholder="Example: 4.5"
                       required>
            </div>

            <!-- Reviews -->
            <div class="beauty-form-group">
                <label>Product Reviews</label>
                <input type="number"
                       name="product_reviews"
                       min="0"
                       placeholder="Enter review count"
                       required>
            </div>

            <!-- New Price -->
            <div class="beauty-form-group">
                <label>Product New Price (₹)</label>
                <input type="number"
                       name="product_new_price"
                       min="0"
                       step="0.01"
                       placeholder="Enter new price"
                       required>
            </div>

            <!-- Old Price -->
            <div class="beauty-form-group">
                <label>Product Old Price (₹)</label>
                <input type="number"
                       name="product_old_price"
                       min="0"
                       step="0.01"
                       placeholder="Enter old price"
                       required>
            </div>

            <!-- Skin Type -->
            <div class="beauty-form-group">
                <label>Skin Type</label>
                <select name="product_skin_type" required>
                    <option value="">Select Skin Type</option>
                    <option value="All Skin Types">All Skin Types</option>
                    <option value="Normal Skin">Normal Skin</option>
                    <option value="Dry Skin">Dry Skin</option>
                    <option value="Oily Skin">Oily Skin</option>
                    <option value="Combination Skin">Combination Skin</option>
                    <option value="Sensitive Skin">Sensitive Skin</option>
                </select>
            </div>

            <!-- Quantity -->
            <div class="beauty-form-group">
                <label>Product Quantity</label>
                <input type="text"
                       name="product_quantity"
                       placeholder="Example: 100ml, 50g, 1 Piece"
                       required>
            </div>

            <!-- Description -->
            <div class="beauty-form-group beauty-full-width">
                <label>Product Description</label>
                <textarea name="product_description"
                          rows="4"
                          placeholder="Enter product description"
                          required></textarea>
            </div>

        </div>

        <div class="beauty-form-buttons">

            <button type="submit" class="beauty-submit-btn">
                <i class="fa-solid fa-plus"></i>
                Add Beauty Product
            </button>

            <button type="reset" class="beauty-reset-btn">
                <i class="fa-solid fa-rotate-left"></i>
                Reset
            </button>

        </div>

    </form>

</div>
<%-include('footer.ejs') %>
